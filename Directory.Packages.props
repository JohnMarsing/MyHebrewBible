<Project>
	<PropertyGroup>
		<!-- Enable Central Package Management -->
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- Central Package Versions -->
	<ItemGroup>
		<PackageVersion Include="Ardalis.SmartEnum" Version="8.2.0" />
		<PackageVersion Include="Blazored.LocalStorage" Version="4.5.0" />
		<PackageVersion Include="Blazored.Toast" Version="4.2.1" />
		<PackageVersion Include="Blazored.Typeahead" Version="4.7.0" />
		<PackageVersion Include="Dapper" Version="2.1.79" />
		
		<PackageVersion Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.9" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
		<PackageVersion Include="MessagePack" Version="3.1.7" />
		<PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.1.26104.118" />
		<PackageVersion Include="Microsoft.Data.SqlClient" Version="5.2.2" />
		<PackageVersion Include="Sentry.AspNetCore.Blazor.WebAssembly" Version="6.6.0" />
		<PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageVersion Include="Serilog.Sinks.BrowserConsole" Version="8.0.0" />
		<PackageVersion Include="Spectre.Console" Version="0.56.0" />
		<PackageVersion Include="SqliteWasmBlazor" Version="0.9.1-pre" />
		<PackageVersion Include="Toolbelt.Blazor.PWA.Updater" Version="3.2.0" />
		<PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.2" />
	</ItemGroup>
</Project>