@using Toolbelt.Blazor.PWA.Updater

@inherits LayoutComponentBase
@inject Microsoft.JSInterop.IJSRuntime JsRuntime

<DomIdsInitializer />

@* 
<header> 
See...
	- Components
		- PageHeader/SemanticHeader.razor
	- Features
		- Home
		- Parasha

</header> *@

<div class="container-fluid px-2 px-sm-2">
	@Body
</div>

<UnhandledError />
<BlazoredToasts />

@* <Authorize />  *@
		
<PWAUpdater />
@* <PWAUpdater State="PWAUpdater.States.Showing" /> *@

<footer class="text-muted">
	<Footer />
</footer>

@code {
	// ToDo: I have two OnAfterRenderAsync events,
	// - here and
	// - PWA\Layout\DomIdsInitializer.razor
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// Initialize global keyboard shortcut to open the search modal (Ctrl+K / Cmd+K)
			await JsRuntime.InvokeVoidAsync("searchHotkeys.init");
		}
	}
}