@using PWA.Features.Bible.Data
@using RCL.Helpers
@using RCL.Enums

@if (IsXs)
{
	<p class="bg-secondary-subtle text-center mb-0 pb-2 fw-bold">
		Strong's: @BibleAnchors.StrongsH_p_Xs(Strongs)
	</p>
}

<article class="mb-4 mt-0">
	<TableTemplate Items="items!.ToList()" HeaderCSS="table table-sm" TheadCSS="table-secondary" TRCSS="table-success">
		<TableHeader>
			<th class=""></th> @* bump  *@
			<th class="">KJV</th>
			<th class="">Transliteration</th>
			<th class=""><span class="float-end">Hebrew</span></th>
			<th class="">#</th>
			@if (!IsXs)
			{
				<th class="">Strong&apos;s</th>
			}
		</TableHeader>
		<RowTemplate>
			<td class=""></td>
			<td>@context.KjvWord</td>
			<td><i>@context.Transliteration</i></td>
			<td class="hebrew py-0">
				@((MarkupString)HebrewFormat.GetSpan(context.WordEnum, context.Hebrew1, context.Hebrew2, context.Hebrew3))
				@HebrewFormat.CheckMaqqef(context.WordEnum, context.Hebrew1, context.Hebrew2, context.Hebrew3)
			</td>
			@if (IsXs)
			{
				@* <td><sup>@BibleAnchors.StrongsH_td_Xs(context.Strongs, context.WordCount)</sup></td> *@
				<td><sup>@context.WordCount</sup></td>
			}
			else
			{
				<td> <sup>@context.WordCount</sup></td>
				<td class="">@BibleAnchors.StrongsH_td(context.Strongs)</td>
			}
		</RowTemplate>
	</TableTemplate>
</article>


@code {
	[Parameter, EditorRequired] public IQueryable<WordPartByScriptureIdAndStrongs>? items { get; set; }
	[Parameter, EditorRequired] public int Strongs { get; set; }
	[Parameter, EditorRequired] public bool IsXs { get; set; }

