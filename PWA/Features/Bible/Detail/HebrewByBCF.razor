@using PWA.Features.Bible.Data

@inject ILogger<HebrewByBCF>? Logger
@inject PWA.Features.Bible.Data.IRepositoryOT? db;

<LoadingComponent IsLoading="items == null" TurnSpinnerOff="TurnSpinnerOff">
	<WordPartTableOT items="items"
								 IsXs="IsXs" 
								 StrongsArray="StrongsArray" />
</LoadingComponent>

@code {
	[Parameter, EditorRequired] public int ScriptureId { get; set; }
	[Parameter, EditorRequired] public BookChapterFilter? BCF { get; set; }
	[Parameter, EditorRequired] public bool IsXs { get; set; }
	[CascadingParameter] private ProcessError? ProcessError { get; set; }

	protected bool TurnSpinnerOff = false;
	protected IQueryable<WordPartByScriptureIdAndStrongs>? items;
	protected int[] StrongsArray = [];

	protected override async Task OnParametersSetAsync()
	{
		ICollection<WordPartByScriptureIdAndStrongs>? hebrewWords;
		try
		{
			if (BCF is not null)
			{
				hebrewWords = await db!.GetWordPartsByBCFOT(BCF.BookId, BCF.Chapter, BCF.Filter);
				if (hebrewWords.Any())
				{
					items = hebrewWords.AsQueryable().Where(w => w.ScriptureID == ScriptureId).OrderBy(o => o.WordCount);
					StrongsArray = items.Select(w => w.Strongs)
													.Distinct()
													.OrderBy(s => s)
													.ToArray();

					Logger!.LogInformation("{Method}; RowCnt: {RowCnt}", nameof(OnParametersSetAsync), items.Count());
				}
			}
		}
		catch (Exception ex)
		{
			ProcessError!.LogErrorWithMessage(ex, nameof(HebrewByBCF), nameof(OnParametersSetAsync), Nav.Bible, $"called: {nameof(db.GetWordPartsByBCFOT)}");
		}
		finally
		{
			TurnSpinnerOff = true;
		}
	}
}

