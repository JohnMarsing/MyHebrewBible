@using PWA.Features.Bible.Enums
@using UserSettingEnums = PWA.Features.Bible.Enums.UserSetting

@inject ILogger<ListGroup>? Logger
@* @inject IToastService? Toast *@

<ol class="list-group list-group-numbered">

	@foreach (var item in UserSettingEnums.List.OrderBy(o => o.Value))
	{
		<li class="list-group-item d-flex justify-content-between align-items-start">
			<div class="ms-2 me-auto">
				<div class="fw-bold">@item.Title</div>
				@GetDetails(item)
			</div>

			<button class=""
							@onclick="() => ButtonClick(item)"
							title="@item.Value | @((int)item.OnState)" type="button">
				<i class="@GetIcon(item) fa-fw fa-2x"></i>
			</button>
		</li>
	}

</ol>

@code {
	[Parameter, EditorRequired] public Permutation Permutations { get; set; }
	[Parameter, EditorRequired] public EventCallback<Permutation> OnPermutationSelected { get; set; }

	protected string GetIcon(UserSettingEnums userSetting)
	{
		
		return Permutations.HasFlag(userSetting.OnState) ? "fas fa-toggle-on" : "fas fa-toggle-off";
	}

	protected string GetDetails(UserSettingEnums userSetting)
	{
		return Permutations.HasFlag(userSetting.OnState) ? userSetting.DetailWhenOn : userSetting.DetailWhenOff;
	}

	private async Task ButtonClick(UserSettingEnums userSetting)
	{
		Permutation newPermutations = Permutations; // copy the current permutations	

		if (newPermutations.HasFlag(userSetting.OnState))
		{
			newPermutations &= ~userSetting.OnState; // remove the flag
		}
		else
		{
			newPermutations |= userSetting.OnState; // add the flag
		}

		//Logger!.LogInformation("{Method}; Permutations: {int}=>{Permutations}"
		//	, nameof(ButtonClick), (int)newPermutations, newPermutations);

		await OnPermutationSelected.InvokeAsync(newPermutations);
	}
}
