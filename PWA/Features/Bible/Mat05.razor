@page "/mat05"

@using PWA.Features.Bible.Data
@using PWA.Features.Bible.Detail
@using RCL.Enums

@inject PWA.Features.Bible.Data.IRepository? db

<h3 class="text-center">Mat 5</h3>

<section class="px-1">
	<LoadingBookChapter IsLoading="FilteredVersesNT == null" TurnSpinnerOff="TurnSpinnerOff" BookChapter="Mat 5">
		@foreach (var item in FilteredVersesNT!.OrderBy(o => o.Header.ID))
		{
			<Paragraph BookAndChapter="GetBookAndChapter(item.Header.BookID, item.Header.Chapter)"
								 VerseHeader="item.Header"
								 ScrollToScriptureId="CurrentScrollToScriptureId"
								 OnVerseSelectedPassThrough="ReturnedVerse" />

			<GreekTable WordPartList="@item.WordPartList" IsXs="false" />
		}
	</LoadingBookChapter>
</section>

@code {
	[CascadingParameter] private ProcessError? ProcessError { get; set; }

	private List<BookChapterNT>? versesNT = null;
	protected List<VerseModelNT>? FilteredVersesNT { get; set; }

	protected bool TurnSpinnerOff = false;
	protected int CurrentScrollToScriptureId = 23237;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			versesNT = await db!.GetBookChapterNT(bookID: 40, chapter: 5);
			FilteredVersesNT = GetBookChapterVersesNT();
		}
		catch (Exception ex)
		{
			ProcessError!.LogErrorWithMessage(ex, nameof(GreekByBCF), nameof(OnInitializedAsync), Nav.Bible, $"called: {nameof(db.GetBookChapterNT)}");
		}
		finally
		{
			TurnSpinnerOff = true;
		}
	}

	protected List<VerseModelNT> GetBookChapterVersesNT()
	{
		return versesNT!
				.OrderBy(o => o.Header.ID)
				.Select(bc => bc.MapFromBookChapterNT(40, 5))
				.ToList();
	}

	protected BookAndChapter GetBookAndChapter(int bookId, int chapter)
	{
		return new BookAndChapter(BibleBook.FromValue(bookId), chapter);
	}

	private void ReturnedVerse(int scriptureId)
	{
		// Test hook only
	}

	protected bool ShowStandaloneAlephTavIcon(int count) => false; // Simplified for NT test (no Aleph-Tav logic)
}
