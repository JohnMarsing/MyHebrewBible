@using System.ComponentModel.DataAnnotations

@* Modal backdrop *@
<div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="findFormModalLabel">
	<div class="modal-dialog" role="document">
		<div class="modal-content">

			<div class="modal-header">
				<h5 class="modal-title" id="findFormModalLabel">Verse Search Criteria</h5>
				<button type="button" class="btn-close" aria-label="Close" @onclick="HandleCancel"></button>
			</div>

			<div class="modal-body">
				<EditForm Model="@VM" OnValidSubmit="HandleValidSubmit">
					<DataAnnotationsValidator />

					<div class="row mb-2 align-items-center">
						<label for="searchText" class="col-4 col-form-label">Word</label>
						<div class="col-8">
							<InputText id="searchText"
								class="form-control form-control-sm"
								maxlength="15"
								@bind-Value="VM.SearchText"
								@ref="_searchTextInput"
								placeholder="Search text…" />
							<ValidationMessage For="() => VM.SearchText" />
						</div>
					</div>

					<ValidationSummary />

					<div class="modal-footer px-0 pb-0">
						<button type="submit" class="btn btn-sm btn-primary">Search</button>
					</div>

				</EditForm>
			</div>

		</div>
	</div>
</div>
<div class="modal-backdrop fade show"></div>

@code {
	[Parameter, EditorRequired] public EventCallback<FilterRecord> OnFilterSelected { get; set; }
	[Parameter, EditorRequired] public EventCallback OnCancel { get; set; }

	private FindFormVM VM = new();
	private InputText? _searchTextInput;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && _searchTextInput?.Element is not null)
		{
			await _searchTextInput.Element.Value.FocusAsync();
		}
	}

	private async Task HandleValidSubmit()
	{
		await OnFilterSelected.InvokeAsync(FilterRecord.From(VM));
	}

	private async Task HandleCancel()
	{
		await OnCancel.InvokeAsync();
	}
}
