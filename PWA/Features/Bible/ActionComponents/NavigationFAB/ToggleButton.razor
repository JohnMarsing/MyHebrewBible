@* @using PWA.Features.Bible.ActionComponents.NavigationFAB.Enums *@


<div class="@MediaQuery.Xs.DivClass">
	<button type="button"
					class="btn btn-primary btn-sm rounded rounded-4 me-1"
					title="@(IsOpen ? "Close navigation" : "Open navigation")"
					@onclick="ButtonClicked">
		<i class="fas fa-chevron-up fab-toggle-icon @(IsOpen ? "is-open" : "")"></i>
	</button>
</div>

<div class="@MediaQuery.SmOrMdOrLgOrXl.DivClass">
	<button type="button"
					class="btn btn-primary rounded rounded-4 me-1"
					title="@(IsOpen ? "Close navigation" : "Open navigation")"
					@onclick="ButtonClicked">
		<i class="fas fa-chevron-up fab-toggle-icon @(IsOpen ? "is-open" : "")"></i>
	</button>

</div>

@code {
	[Parameter, EditorRequired] public bool IsOpen { get; set; }
	[Parameter, EditorRequired] public EventCallback OnToggleSelected { get; set; }

	private async Task ButtonClicked()
	{
		await OnToggleSelected.InvokeAsync();
	}

}
