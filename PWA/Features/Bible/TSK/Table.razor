@using PWA.Features.Bible.TSK
@using PWA.Features.Bible.TSK.Data
@using RCL.Enums
@using RCL.Constants

@inject PWA.Features.Bible.TSK.Data.IRepository? db;
@inject ILogger<Table>? Logger
@inject NavigationManager NavigationManager

<LoadingComponent IsLoading="verses == null" TurnSpinnerOff="TurnSpinnerOff">

	<TableTemplate Items="verses!.OrderBy(o => o.RowNum).ToList()" HeaderCSS="@($"table table-bordered border-info table-hover {HeaderSize}")">
		<TableHeader>
			<th>#</th>
			<th>BCV</th>
			@* <th>👍</th> *@
			<th>KJV</th>
		</TableHeader>
		<RowTemplate>
			<td>@context.RowNum</td>
			<td class="fw-bold @GetBG(context)">
				<a class=""
					 @onclick="@(e => ButtonClicked(context.BookID, context.Chapter, context.Verse))">
					@context.BCV
				</a>
			</td>
			@* <td>@context.Votes</td> *@
			<td class="@GetBG(context)">@((MarkupString)@context.KJV!)</td>

		</RowTemplate>
	</TableTemplate>
</LoadingComponent>

@code {
	[Parameter, EditorRequired] public BibleBookChapterVerseId BBCVID { get; set; }
	[Parameter, EditorRequired] public string HeaderSize { get; set; }
	[Parameter, EditorRequired] public EventCallback OnCancel { get; set; }
	
	[CascadingParameter] public CascadingAppState? State { get; set; }
	[CascadingParameter] private ProcessError? ProcessError { get; set; }

	protected bool TurnSpinnerOff = false;
	private List<Record>? verses = null;

	protected override async Task OnParametersSetAsync()
	{
		try
		{
			verses = await db!.GetTSK(BBCVID.ScriptureId);
			if (verses is null)
			{
				ProcessError!.ShowToast($"Scripture {BBCVID.ScriptureId} not found  (◡︵◡)", ToastLevel.Warning);
				await OnCancel.InvokeAsync();
			}
		}
		catch (Exception ex)
		{
			ProcessError!.LogErrorWithMessage(ex, nameof(Table), nameof(OnParametersSetAsync), Nav.Bible, $"called: {nameof(db.GetTSK)}");
			await OnCancel.InvokeAsync();
		}
		finally
		{
			TurnSpinnerOff = true;
		}
	}

	protected string GetBG(Record record)
	{
		return record.BookID <= BookChapterFacts.LastBookInOT ? "bg-warning-subtle" : "bg-primary-subtle";
	}

	private async Task ButtonClicked(int bookId, int chapter, int verse)
	{
		await OnCancel.InvokeAsync();

		await State!.AppState!.BookChapterState!.UpdateACV(Bible.AbrvChapterVerse.FromBookBBCVID(BBCVID));
		await State!.AppState!.BookChapterState!.AddStoredAcvToBcvList();

		NavigationManager!.NavigateTo($"{Nav.Bible.Index}/{BibleBook.FromValue(bookId).Abrv}/{chapter}/{verse}/{true}"); // {ShowLastBCV:bool?}

	}

}
