@using PWA.Features.Bible.ActionComponents.RecentBCV
@using PWA.Features.Bible.ActionComponents
@using PWA.Features.Bible.ActionComponents.ToC
@using PWA.Features.Bible.ActionComponents.NavigationFAB

<div class="bg-info-subtle p-1 border-top border-primary border-2">

	<div class="d-flex justify-content-between">

		<div class="d-flex justify-content-start">
			<button class="btn btn-warning btn-sm rounded rounded-4 me-1"
							@onclick="() => ReturnedButton(ButtonType.Find)"
							title="Find text">
				<i class="fa-solid fa-magnifying-glass"></i>
			</button>
			<button class="btn btn-success btn-sm rounded rounded-4 me-1"
							@onclick="() => ReturnedButton(ButtonType.Parasha)"
							title="Parasha verses">
				<i class="fa-solid fa-p"></i>
			</button>

		</div>

		<div class="d-flex justify-content-center">

			<button class="btn btn-primary btn-sm rounded rounded-1 me-1 @(_isBCVChanged ? "bcv-flash" : "")"
							@onclick="() => ReturnedButton(ButtonType.BCV)"
							title="Change book/chapter/verse">
				<span class="fs-6 fw-bold text-white me-1">
					@((MarkupString)GetDropDownMarkup())
				</span>
				<i class="fas fa-angle-down"></i>
			</button>

			<HistoryDropdown BtnSize="btn-xs rounded rounded-3">
				<Recent>
					<RecentListPicker OnBCVSelected="ReturnedBCV" />
				</Recent>
				<Parashot>
					<ParashotPicker OnBCVSelected="ReturnedBCV" />
				</Parashot>
			</HistoryDropdown>

		</div>

		<div class="d-flex justify-content-end align-items-end gap-1 me-2">
			<ModalButton OnButtonSelected="ReturnedButton" />
			<Wrapper BCV="BCV" OnBCVSelected="ReturnedBCV" />
		</div>
	</div>
</div>

@code {
	[Parameter, EditorRequired] public BookChapterVerseRecord BCV { get; set; }
	[Parameter, EditorRequired] public EventCallback<ButtonType> OnButtonSelected { get; set; }
	[Parameter, EditorRequired] public EventCallback<BookChapterVerseRecord> OnBCVSelected { get; set; }

	private BookChapterVerseRecord? _previousBCV;

	private bool _isBCVChanged;
	protected override async Task OnParametersSetAsync()
	{
		if (_previousBCV is not null && !_previousBCV.Equals(BCV))
		{
			_isBCVChanged = true;
			StateHasChanged();
			await Task.Delay(200); // 1000
			_isBCVChanged = false;
			StateHasChanged();
		}
		_previousBCV = BCV;
	}

	private string GetDropDownMarkup()
	{
		return $"<span class='text white {MediaQuery.Xs.InlineClass} {BCVChangedCSS()}'>{BCV!.BibleBook!.Abrv} {BCV.Chapter}</span>" +
				$"<span class='text white {MediaQuery.SmOrMdOrLgOrXl.InlineClass} {BCVChangedCSS()}'>{BCV!.BibleBook!.Title} {BCV.Chapter}</span>";
	}

	/*
	private string GetDropDownMarkupCS11()
	{
		return $"""
			<span class='text white {MediaQuery.Xs.InlineClass} {BCVChangedCSS()}'>
					{BCV!.BibleBook!.Abrv} {BCV.Chapter}
			</span>
			<span class='text white {MediaQuery.SmOrMdOrLgOrXl.InlineClass} {BCVChangedCSS()}'>
					{BCV!.BibleBook!.Title} {BCV.Chapter}
			</span>
			""";
	}
	*/

	private string BCVChangedCSS()
	{
		return _isBCVChanged ? "bcv-flash" : "text white ";
	}

	private void ReturnedButton(ButtonType buttonType)
	{
		OnButtonSelected.InvokeAsync(buttonType);
	}

	// A Passthrough from ????
	private async Task ReturnedBCV(BookChapterVerseRecord bcv)
	{
		await OnBCVSelected.InvokeAsync(bcv);
	}
}