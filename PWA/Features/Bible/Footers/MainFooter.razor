@using PWA.Features.Bible.ActionComponents.RecentBCV
@using PWA.Features.Bible.ActionComponents

<div class="bg-info-subtle p-1 border-top border-primary border-2">

	<div class="d-flex justify-content-between">
		
		<div class="d-flex justify-content-start">
			<button class="btn btn-info btn-sm rounded rounded-4 me-1"
							@onclick="() => ReturnedButton(ButtonType.Find)"
							title="Find text">
				<i class="fa-solid fa-magnifying-glass"></i>
			</button>
		</div>
		
		<div class="d-flex justify-content-center">

			<div class="d-flex justify-content-center align-items-center m-0 pb-1">
				<div class="@MediaQuery.Xs.DivClass">
					<span class="fs-6 fw-bold @(_isBCVChanged ? "bcv-flash" : "text-success") me-1">@BCV!.BibleBook!.Abrv @BCV.Chapter</span>
				</div>

				<div class="@MediaQuery.SmOrMdOrLgOrXl.DivClass">
					<span class="fs-6 fw-bold @(_isBCVChanged ? "bcv-flash" : "text-success") me-1">@BCV!.BibleBook!.Title @BCV.Chapter</span>
				</div>
			</div>

			<button class="btn btn-info btn-sm rounded rounded-4 me-1"
							@onclick="() => ReturnedButton(ButtonType.BCV)"
							title="Change book/chapter/verse">
				<i class="fa-solid fa-arrow-up"></i>
			</button>


			<HistoryDropdown BtnSize="btn-xs rounded rounded-3">
				<Recent>
					<RecentListPicker OnBCVSelected="ReturnedBCV" />
				</Recent>
				<Parashot>
					<ParashotPicker OnBCVSelected="ReturnedBCV" />
				</Parashot>
			</HistoryDropdown>
 
		</div>

		<div class="d-flex justify-content-end align-items-end gap-1 me-2">
			<button class="btn btn-info btn-sm rounded rounded-4 me-1"
							@onclick="() => ReturnedButton(ButtonType.ToC)"
							title="Table of Content">
				<i class="fa-solid fa-t"></i>
			</button>
			<NavigationFAB BCV="BCV" OnBCVSelected="ReturnedBCV" />
		</div>

	</div>
</div>

@code {
	[Parameter, EditorRequired] public BookChapterVerseRecord BCV { get; set; }
	[Parameter] public string? TextFilter { get; set; }
	[Parameter, EditorRequired] public EventCallback<ButtonType> OnButtonSelected { get; set; }
	[Parameter, EditorRequired] public EventCallback<BookChapterVerseRecord> OnBCVSelected { get; set; }

	private BookChapterVerseRecord? _previousBCV;
	private bool _isBCVChanged;

	protected override async Task OnParametersSetAsync()
	{
		if (_previousBCV is not null && !_previousBCV.Equals(BCV))
		{
			_isBCVChanged = true;
			StateHasChanged();
			await Task.Delay(1000);
			_isBCVChanged = false;
			StateHasChanged();
		}
		_previousBCV = BCV;
	}

	private void ReturnedButton(ButtonType buttonType)
	{
		OnButtonSelected.InvokeAsync(buttonType);
	}

	private async Task ReturnedBCV(BookChapterVerseRecord bcv)
	{
		await OnBCVSelected.InvokeAsync(bcv);
	}
}