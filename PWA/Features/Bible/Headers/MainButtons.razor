
@using PWA.Features.Bible.Toolbar
@using MenuItemEnums = PWA.Features.Bible.Enums.MenuItem

@inject ILogger<MainButtons>? Logger

<PageTitle>@Nav.Bible.Title</PageTitle>


<nav class="navbar navbar-expand bg-primary-subtle">

	<div class="collapse navbar-collapse justify-content-start">

		<div class="ps-1">
			<SitemapButton />
		</div>

	</div>

	<div class="ps-1">

		@if (CurrentBookAndChapter is not null)
		{
			@if (CurrentBookAndChapter.BibleBook!.Title.Length > 11)
			{
				<span class="fw-bold text-primary fs-6">@CurrentBookAndChapter.BibleBook!.Title	@CurrentBookAndChapter.Chapter </span>
			}
			else
			{
				<span class="fw-bold text-primary fs-4">@CurrentBookAndChapter.BibleBook!.Title	@CurrentBookAndChapter.Chapter </span>
			}
		}
	</div>

	<div class="collapse navbar-collapse justify-content-end">
		<div class="pe-1">

			<div class="@MediaQuery.Xs.DivClass">
				<MenuTemplate Items="menuItems" BtnSize="btn-sm" OnItemSelected="ReturnedMenuItemPassThrough" />
			</div>
			<div class="@MediaQuery.SmOrMdOrLgOrXl.DivClass">
				<MenuTemplate Items="menuItems" OnItemSelected="ReturnedMenuItemPassThrough" />
			</div>

		</div>

	</div>

</nav>

@code {
	[Parameter, EditorRequired] public BookChapterVerseRecord? BCV { get; set; }
	[Parameter, EditorRequired] public EventCallback<int> OnMenuItemSelectedPassThrough { get; set; }
	[Parameter, EditorRequired] public EventCallback<BookChapterVerseRecord> OnBCVSelected { get; set; }

	public BookAndChapter? CurrentBookAndChapter { get; set; }

	protected override void OnParametersSet()
	{
		if (BCV is not null)
		{
			CurrentBookAndChapter = new BookAndChapter(BCV.BibleBook, BCV.Chapter);
		}
	}

	private List<Dictionary<int, string?>> menuItems = MenuItemEnums.List
		.Select(item => new Dictionary<int, string?> { { item.Value, item.Title } })
		.ToList();

	private void ReturnedMenuItemPassThrough(int menuItem)
	{
		OnMenuItemSelectedPassThrough.InvokeAsync(menuItem);
	}

	private void ReturnedBookAndChapter(BookAndChapter bookAndChapter)
	{
		OnBCVSelected.InvokeAsync(new BookChapterVerseRecord(bookAndChapter.BibleBook, bookAndChapter.Chapter, 1));
	}
}
