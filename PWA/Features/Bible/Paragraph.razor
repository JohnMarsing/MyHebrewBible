@using PWA.Features.Bible.Data
@using PWA.Features.Bible.Summary
@using PWA.Features.Bible.TSK

@* @inject IToastService? Toast *@

@if (VerseHeader != null)
{
	<p id="@VerseHeader.ID" class="fs-5 @textBG">
		<sup class="text-primary" title="@VerseHeader.ID"><b>@VerseHeader.Verse</b></sup>

		@* Only relevant for OT *@
		@if (VerseHeader.VerseOffset != "NULL")
		{
			<sup class="text-black-50">&nbsp;@VerseHeader.VerseOffset&nbsp;</sup>
		}
		else
		{
			<text>&nbsp;</text>
		}
		@((MarkupString)HighlightedKjv)

		@if (ShowStandaloneAlephTavIcon is not null && ShowStandaloneAlephTavIcon == true)
		{
			<span><i class="fa fa-letter-aleph-tav text-danger ps-2"></i></span>
		}

		<DrillDownButton ScriptureId="VerseHeader!.ID"
										 OnVerseSelected="ReturnedVersePassThrough" />
		<sup>
			<BibleAnchor BookAndChapter="BookAndChapter"
									 IconOnly="true"
									 ScriptureId="VerseHeader!.ID"
									 Verse="VerseHeader.Verse" />
		</sup>
		<Button BCV="@VerseHeader.BCV" Id="@VerseHeader.ID" TskRowCount="@VerseHeader.TskRowCount" />
	</p>
}

@code {
	[Parameter, EditorRequired] public VerseHeader? VerseHeader { get; set; }
	[Parameter, EditorRequired] public BookAndChapter? BookAndChapter { get; set; }
	[Parameter] public bool? ShowStandaloneAlephTavIcon { get; set; } = null;
	[Parameter] public int ScrollToScriptureId { get; set; }
	[Parameter] public EventCallback<int> OnVerseSelectedPassThrough { get; set; }
	[Parameter] public string? HighlightText { get; set; }


	string textBG => ScrollToScriptureId == VerseHeader!.ID ? " p-1 bg-info-subtle" : "";

	string HighlightedKjv
	{
		get
		{
			var kjv = VerseHeader?.KJV;
			if (string.IsNullOrWhiteSpace(kjv) || string.IsNullOrWhiteSpace(HighlightText))
				return kjv ?? string.Empty;

			return System.Text.RegularExpressions.Regex.Replace(
				kjv,
				System.Text.RegularExpressions.Regex.Escape(HighlightText),
				m => $"<mark>{m.Value.Trim()}</mark>",
				System.Text.RegularExpressions.RegexOptions.IgnoreCase
			);
		}
	}

	private void ReturnedVersePassThrough(int scriptureId)
	{
		//Toast!.ShowWarning($"ReturnedVersePassThrough {scriptureId}");
		OnVerseSelectedPassThrough.InvokeAsync(scriptureId);
	}
}
