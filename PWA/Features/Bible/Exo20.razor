@page "/exo20"

@using PWA.Features.Bible.Data
@using PWA.Features.Bible.Detail
@using RCL.Enums

@inject PWA.Features.Bible.Data.IRepository? db

<h3 class="text-center">Exo 20</h3>

<section class="px-1">
	<LoadingBookChapter IsLoading="FilteredVerses == null" TurnSpinnerOff="TurnSpinnerOff" BookChapter="Exo 20">
		@foreach (var item in FilteredVerses!.OrderBy(o => o.Header.ID))
		{
			<Paragraph BookAndChapter="GetBookAndChapter(item.Header.BookID, item.Header.Chapter)"
								 VerseHeader="item.Header"
								 ScrollToScriptureId="CurrentScrollToScriptureId"
								 OnVerseSelectedPassThrough="ReturnedVerse" />

			<HebrewTable WordPartList="@item.WordPartList" IsXs="true" />
		}
	</LoadingBookChapter>
</section>

@code {
	[CascadingParameter] private ProcessError? ProcessError { get; set; }

	private List<Data.BookChapterWithOT>? verses = null;
	protected List<VerseModel>? FilteredVerses { get; set; }

	protected bool TurnSpinnerOff = false;
	protected int CurrentScrollToScriptureId = 2057; // Exo 20:5

	protected override async Task OnInitializedAsync()
	{
		try
		{
			verses = await db!.GetBookChapterOT(bookID: 2, chapter: 20);
			FilteredVerses = GetBookChapterVerses();
		}
		catch (Exception ex)
		{
			ProcessError!.LogErrorWithMessage(ex, nameof(Exo20), nameof(OnInitializedAsync), Nav.Bible, $"called: {nameof(db.GetBookChapterOT)}");
		}
		finally
		{
			TurnSpinnerOff = true;
		}
	}

	protected List<VerseModel> GetBookChapterVerses()
	{
		return verses!
				.OrderBy(o => o.Header.ID)
				.Select(bc => bc.MapFromBookChapter(2, 20))
				.ToList();
	}


	protected BookAndChapter GetBookAndChapter(int bookId, int chapter)
	{
		return new BookAndChapter(BibleBook.FromValue(bookId), chapter);
	}

	private void ReturnedVerse(int scriptureId)
	{
		// Test hook only
	}

	protected bool ShowStandaloneAlephTavIcon(int count) => false; // Simplified for NT test (no Aleph-Tav logic)
}
