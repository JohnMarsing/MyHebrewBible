@page "/Bible"

@using Dapper;
@using PWA.Features.Bible.Data

@using DirEnums = Enums.VerticalDirection
@using DirHelper = Enums.VerticalDirectionHelper

@* @using ToolbarEnums = PWA.Features.Bible.Toolbar.Enums *@
@using PWA.Features.Bible.Enums
@using UserSettingEnums = PWA.Features.Bible.Enums.UserSetting
@using MenuItemEnums = PWA.Features.Bible.Enums.MenuItem

@using PWA.Features.Bible.ActionComponents.LookupBCV
@using PWA.Features.Bible.ActionComponents.Find
@using PWA.Features.Bible.ActionComponents.ToC
@using PWA.Features.Bible.Toolbar
@using RCL.Enums

@inject PWA.Features.Bible.Data.IRepository? db;
@inject ILogger<Index>? Logger
@inject IToastService? Toast

@inject IJSRuntime JSRuntime
@implements IAsyncDisposable


<header>
	<Buttons BCV="@BCV" OnMenuItemSelectedPassThrough="ReturnedMenuItemId" />
</header>

<ModalSkeleton ShowMenuItem="CurrentModalToShow">
	<InstructionsModal>
		<PageInstructions OnClose="ReturnedCloseEvent" />
	</InstructionsModal>
	<UserConfigurationModal>
		<EditModal OnUserSettingsSelected="ReturnUserSettingsDTO" OnClose="ReturnedCloseEvent" />
	</UserConfigurationModal>
</ModalSkeleton>

<LoadingComponent IsLoading="FilteredVerses == null" TurnSpinnerOff="TurnSpinnerOff">

	<section class="px-1">

		<Sections FilteredVerses="FilteredVerses"
								ParmScrollToScriptureId="CurrentScrollToScriptureId"
								UserSettings="UserSettings" 
								HighlightText="@HighlightText" />

	</section>

	<footer class="sticky-bottom">
		<Footer BCV="@BCV" TextFilter="@TextFilter"
						OnActionSelected="ReturnedAction"
						OnClearClicked="ReturnedClearAction"
						OnBCVSelected="ReturnedBCVSelected" />
	</footer>

</LoadingComponent>

@if (currentAction is not null)
{
	@if (currentAction == Enums.Action.Toc)
	{
		<SubtitleModal Title="@FilteredVerses?.GetTitle()"
									 Data="FilteredVerses?.ToTableOfContentMapping().ToList()"
									 OnSelected="ReturnedTOC"
									 OnCancel="CloseModal" />
	}
	else if (currentAction == Enums.Action.Find)
	{
		@* ToDo: do I need to concerned if BCV or BibleBook is null *@
		<TextOrStrongsForm IsHebrewBible="BCV!.BibleBook!.IsHebrewBible"
											 OnFilterSelected="ReturnedFilterSelected"
											 OnCancel="CloseModal" />
	}
	else if (currentAction == Enums.Action.BCV)
	{
		<BCVForm OnSelected="ReturnedBCVSelected" OnCancel="CloseModal" />
	}

}

@* else { <Alert>currentAction is null</Alert>	 } *@

@code {
	[CascadingParameter] public CascadingAppState? State { get; set; }

	protected UserSettingsDTO? UserSettings { get; set; }

	protected Bible.AbrvChapterVerse? CurrentAbrvChapterVerse;
	protected bool TurnSpinnerOff = false;
	private List<Data.BookChapterWithAT>? verses = null;
	private BookChapterVerseRecord BCV { get; set; } = null!;
	protected List<ReportModel>? FilteredVerses { get; set; }

	protected override async Task OnInitializedAsync()
	{
		try
		{
			SetScriptureIdAndBCV();
			verses = await db!.GetBookChapterWithAT(bookID: BCV.BibleBook!.Value, chapter: BCV.Chapter);
			FilteredVerses = GetBookChapterVerses();
		}
		catch (Exception ex)
		{
			Logger!.LogError(ex, "{Method}", nameof(OnInitializedAsync));
		}
		finally
		{
			TurnSpinnerOff = true;
		}
	}

	protected override void OnParametersSet()
	{
		//Logger!.LogDebug("{Method}, Route: {Abrv}/{Chapter}/{Verse}/{ScriptureId}", nameof(OnParametersSet), Abrv, Chapter, Verse, ScriptureId);
		try
		{
			PWA.Features.Bible.Enums.Permutation _currentPermutations = (PWA.Features.Bible.Enums.Permutation)State!.AppState!.BookChapterState!.GetUserSetting();
			UserSettings = new UserSettingsDTO(
				IsStandaloneAlephTavDetailsOn: _currentPermutations.HasFlag(PWA.Features.Bible.Enums.Permutation.StandaloneAlephTavDetailOn),
				IsParashaDividerDetailsOn: _currentPermutations.HasFlag(PWA.Features.Bible.Enums.Permutation.ParashaDividerDetailOn),
				IsHebrewWordNumbersOn: _currentPermutations.HasFlag(PWA.Features.Bible.Enums.Permutation.HebrewWordNumbersOn),
				IsVerseScrollButtonsOn: _currentPermutations.HasFlag(PWA.Features.Bible.Enums.Permutation.VerseScrollButtonsOn));
		}
		catch (Exception ex)
		{
			Logger!.LogError(ex, "{Method}", nameof(OnParametersSet));
			Toast!.ShowError($"{Global.ToastShowError} {nameof(Index)}!{nameof(OnParametersSet)}");
		}
	}

	// ToDo: can `SetScriptureIdAndBCV` this logic be pushed down to RCL.Enums i.e. `BibleBookHelper.cs`?
	// - I would have to somehow pass in State
	private void SetScriptureIdAndBCV()
	{
		CurrentAbrvChapterVerse = State!.AppState!.BookChapterState!.GetACV(); // get from local storage, if not found use default (Gen 1:1); sometime Genesis is returned instead of Gen???

		var (errMsg, _value) = BibleBookDictionary.GetId(CurrentAbrvChapterVerse.Abrv); // based on the lookup, convert the abrv to a BibleBook.Value
		if (!String.IsNullOrEmpty(errMsg))
		{
			Logger!.LogWarning("{Method}, {errMsg}", nameof(SetScriptureIdAndBCV), errMsg);
			throw new InvalidOperationException(errMsg);
		}

		BibleBook? bibleBook;
		if (BibleBook.TryFromValue(_value, out bibleBook))  // Lookup the SmartEnum based on the newly acquired BibleBook.Value
		{
			BCV = new BookChapterVerseRecord(bibleBook, CurrentAbrvChapterVerse.Chapter, CurrentAbrvChapterVerse.Verse);
			CurrentScrollToScriptureId = CurrentAbrvChapterVerse.ScriptureId; // = 1;
		}
		else
		{
			Logger!.LogWarning("{Method}, {errMsg}", nameof(SetScriptureIdAndBCV), errMsg);
			throw new InvalidOperationException("BibleBook.TryFromValue fa");
		}
	}

	protected List<ReportModel> GetBookChapterVerses()
	{
		return verses!
				.OrderBy(o => o.ID)
				.Select(bc => bc.ToReportModel(BCV!.BibleBook!.Value, BCV.Chapter))
				.ToList();
	}



	#region EventCallback Return Logic
	/*
	ToDo: Consider a new feature; what if you persisted the last action
	- maybe pre-populate the modal/form with the last search? Would that be helpful or just annoying?
		- if you could persist a list, then you could show a dropdown of recent searches/actions.
		next to the Find button not unlike the B/C History
 */

	private string? TextFilter;
	//private string? StrongsFilter;
	private string? HighlightText;

	private void ReturnedFilterSelected(FilterRecord filter)
	{
		TextFilter = !string.IsNullOrEmpty(filter.Description) ? filter.Description : null;
		//StrongsFilter = filter.Strongs;
		HighlightText = filter.SearchText;
		ApplyFilter(filter);
		currentAction = null;
	}

	private void ApplyFilter(FilterRecord filter)
	{
		var hasText = !string.IsNullOrWhiteSpace(filter.SearchText);

		if (!hasText)
		{
			FilteredVerses = GetBookChapterVerses();
			return;
		}

		FilteredVerses = GetBookChapterVerses()
			.Where(v => v.KJV?.Contains(filter.SearchText!, StringComparison.OrdinalIgnoreCase) ?? false)
			.ToList();
	}

	private void CloseModal()
	{
		currentAction = null;
	}

	/*
	Called by StickFooter when Clear button the TextOrStrongsForm! clicked,
	ToDo:
	 but also consider other scenarios where you want to clear the filter and return to the default state.
	 */
	private void ReturnedClearAction()
	{
		currentAction = null;
		HighlightText = null;
		TextFilter = null;
		FilteredVerses = GetBookChapterVerses();
	}

	private async Task ReturnedTOC(ActionComponents.VerseAndID rec)
	{
		CurrentScrollToScriptureId = rec.ID;
		CurrentVerse = rec.Verse;
		await SetFocusToElement();
		currentAction = null;
	}

	private async Task ReturnedBCVSelected(BookChapterVerseRecord bcv)
	{
		currentAction = null;
		BCV = bcv;
		try
		{
			verses = await db!.GetBookChapterWithAT(bcv.BibleBook!.Value, bcv.Chapter);
		}
		catch (Exception ex)
		{
			Logger!.LogError(ex, "{Method}, {Message}", nameof(ReturnedBCVSelected), $"Error occurred while calling {nameof(db.GetBookChapterWithAT)}");
			Toast!.ShowError("Failed to load verses. Please try again.");
			return;
		}

		FilteredVerses = GetBookChapterVerses();
		CurrentScrollToScriptureId = bcv.ScriptureId;
		CurrentVerse = bcv.Verse;
		await SetFocusToElement();
	}


	//
	protected Enums.Action? currentAction = null;
	private async Task ReturnedAction(Enums.Action action)
	{
		currentAction = action;
	}

	protected int CurrentScrollToScriptureId;
	protected int CurrentVerse;

	private void SetScriptureIdAndVerse(DirEnums dirEnums)
	{
		var (errMsg, verse, _scriptureId) =
			DirHelper.GetVerseAndScriptureId(dirEnums, CurrentScrollToScriptureId, FilteredVerses!);

		if (!String.IsNullOrEmpty(errMsg))
		{
			Toast!.ShowWarning(errMsg);
			return;
		}
		else
		{
			CurrentScrollToScriptureId = _scriptureId;
			CurrentVerse = verse;
		}

		if (CurrentScrollToScriptureId != CurrentAbrvChapterVerse!.ScriptureId)
		{
			CurrentAbrvChapterVerse = CurrentAbrvChapterVerse!
				with
			{ Verse = verse, ScriptureId = CurrentScrollToScriptureId };
		}
	}

	#endregion

	// Called by: ReturnedTOC, ReturnedBCVSelected
	private async Task SetFocusToElement()
	{
		if (_module is not null)
		{
			await _module.InvokeVoidAsync(JSFunctionSetFocus, $"verse-{CurrentScrollToScriptureId}");
		}
	}


	#region EventCallback Return Toolbar Logic


	private void ReturnUserSettingsDTO(UserSettingsDTO userSettingsDTO)
	{
		//Logger!.LogDebug("{Method}, UserSettingsDTO: {UserSettingsDTO}", nameof(ReturnUserSettingsDTO), userSettingsDTO);
		UserSettings = userSettingsDTO;
	}

	protected MenuItem? CurrentModalToShow { get; set; }
	private void ReturnedMenuItemId(int id)
	{
		//Logger!.LogDebug("{Method}, id: {Id}", nameof(ReturnedMenuItemId), id);
		if (MenuItemEnums.TryFromValue(id, out MenuItemEnums? menuItem))
		{
			CurrentModalToShow = menuItem;
		}
		else
		{
			Logger!.LogWarning("{Method}, Invalid MenuItem: {Id}", nameof(ReturnedMenuItemId), id);
			Toast!.ShowError($"{Global.ToastShowError} {nameof(Index)}!{nameof(ReturnedMenuItemId)} {id}");
		}
	}

	private void ReturnedCloseEvent()
	{
		CurrentModalToShow = null;
		//Logger!.LogDebug("{Method}, CurrentModalToShow set to null", nameof(ReturnedCloseEvent));
	}

	#endregion

	#region JavaScript Setup and Teardown

	private IJSObjectReference? _module;
	protected bool _firstRendered = false;
	
	const string JSFunctionScrollTo = "scrollToElement";
	const string JSFunctionSetFocus = "setFocusToElement";

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && !_firstRendered)
		{
			try
			{
				_module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Features/Bible/Index.razor.js");
				if (_module != null)
				{
					await _module.InvokeVoidAsync(JSFunctionScrollTo, $"verse-{CurrentScrollToScriptureId}");
					await _module.InvokeVoidAsync(JSFunctionSetFocus, $"verse-{CurrentScrollToScriptureId}");
				}
			}
			catch (Exception ex)
			{
				Logger!.LogError(ex, "{Method} failed to load JS module or set focus", nameof(OnAfterRenderAsync));
			}
			_firstRendered = true;
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (_module is not null)
		{
			await _module.DisposeAsync();
		}
	}

	#endregion
}
