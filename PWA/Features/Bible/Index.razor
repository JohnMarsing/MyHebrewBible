@page "/bible"
@page "/bible/{BookAbrv}/{Chapter:int}/{Verse:int}/{ShowLastBCV:bool?}"

@using PWA.Features.Bible.Data
@using PWA.Features.Bible.Enums

@using MenuItemEnums = PWA.Features.Bible.Enums.MenuItem

@using PWA.Features.Bible.ActionComponents.LookupBCV
@using PWA.Features.Bible.ActionComponents.ToC
@using PWA.Features.Bible.Filtered
@using PWA.Features.Bible.Headers
@using PWA.Features.Bible.Toolbar
@using PWA.Features.Bible.Footers
@using PWA.Features.Bible.Parasha

@using RCL.Enums

@inject PWA.Features.Bible.Data.IRepositoryOT? dbOT;
@inject PWA.Features.Bible.Data.IRepositoryNT? dbNT;
@inject ILogger<Index>? Logger
@inject IToastService? Toast

@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<header>
	@if (currentAction == Footers.ButtonType.Parasha)
	{
		<ParashaButtons Title="Parasha" />
		<div class="@MediaQuery.XsOrSm.DivClass">
			<ParashaTable IsMdOrLgOrXl="false" />
		</div>
		<div class="@MediaQuery.MdOrLgOrXl.DivClass">
			<ParashaTable IsMdOrLgOrXl="true" />
		</div>
	}
	else
	{
		<MainButtons BCV="@BCV"
								 OnMenuItemSelectedPassThrough="ReturnedMenuItemId"
								 OnBCVSelected="ReturnedBCVSelected" />

		@if (ShowLastBCV)
		{
			<LastBCVButton />
		}
	}

</header>

<ModalSkeleton ShowMenuItem="CurrentModalToShow">
	<InstructionsModal>
		<PageInstructions OnClose="ReturnedCloseEvent" />
	</InstructionsModal>
	<UserConfigurationModal>
		<EditModal OnUserSettingsSelected="ReturnUserSettingsDTO" OnClose="ReturnedCloseEvent" />
	</UserConfigurationModal>
</ModalSkeleton>

<section class="px-1">

	@if (currentAction == Footers.ButtonType.Parasha)
	{
		<ParashaWrapper OnParashaClosed="ReturnedParashaClosed" />
	}
	else
	{
		if (currentAction == Footers.ButtonType.Find && !String.IsNullOrEmpty(TextFilter))
		{
			<FilteredWrapper ParamBookAndChapter="new BookAndChapter(BCV.BibleBook, BCV.Chapter)"
											 verses="verses"
											 versesNT="versesNT"
											 TextFilter="@TextFilter"
											 OnFilteredClosed="ReturnedFilteredClosed" />
		}
		else
		{
			@if (BCV.BibleBook!.IsHebrewBible)
			{
				<LoadingBookChapter IsLoading="FilteredVersesOT == null" TurnSpinnerOff="TurnSpinnerOff" BookChapter="@($"{BCV.BibleBook.Title} {BCV.Chapter}")">
					<SectionsOT FilteredVersesOT="FilteredVersesOT"
											ParmScrollToScriptureId="CurrentScrollToScriptureId" />
				</LoadingBookChapter>
			}
			else
			{
				<LoadingBookChapter IsLoading="FilteredVersesNT == null" TurnSpinnerOff="TurnSpinnerOff" BookChapter="@($"{BCV.BibleBook.Title} {BCV.Chapter}")">
					<SectionsNT FilteredVersesNT="FilteredVersesNT"
											ParmScrollToScriptureId="CurrentScrollToScriptureId" />
				</LoadingBookChapter>
			}

		}
	}
</section>

<footer class="sticky-bottom">

	@if (currentAction == Footers.ButtonType.Find)
	{
		if (String.IsNullOrEmpty(TextFilter))
		{
			<FindForm OnFilterSelected="ReturnedFilterSelected" OnCancel="CloseModal" />
		}
		else
		{
			<FilterFooter TextFilter="@TextFilter" OnClearClicked="ReturnedClearAction" />
		}
	}
	else
	{
		@if (currentAction == Footers.ButtonType.Parasha)
		{
		}
		else
		{
			<MainFooter BCV="@BCV"
									OnButtonSelected="ReturnedButtonType"
									OnBCVSelected="ReturnedBCVSelected" />
		}

	}
</footer>


@if (currentAction is not null)
{
	@if (currentAction == Footers.ButtonType.ToC)
	{
		@if (currentAction == Footers.ButtonType.ToC)
		{
			var (title, data) = BCV.BibleBook!.IsHebrewBible
					? (FilteredVersesOT?.GetTitleOT(), FilteredVersesOT?.ToTableOfContentMappingOT().ToList())
					: (FilteredVersesNT?.GetTitleNT(), FilteredVersesNT?.ToTableOfContentMappingNT().ToList());

			<SubtitleModal Title="@title"
										 Data="data"
										 OnSelected="ReturnedTOC"
										 OnCancel="CloseModal" />
		}
	}
	else if (currentAction == Footers.ButtonType.BCV)
	{
		<BCVForm OnSelected="ReturnedBCVSelected" OnCancel="CloseModal" />
	}

}


@code {
	// Route parameters
	[Parameter] public string? BookAbrv { get; set; }
	[Parameter] public int Chapter { get; set; }
	[Parameter] public int Verse { get; set; }
	[Parameter] public bool ShowLastBCV { get; set; } = false;

	[CascadingParameter] public CascadingAppState? State { get; set; }
	[CascadingParameter] private ProcessError? ProcessError { get; set; }

	protected Bible.AbrvChapterVerse? CurrentAbrvChapterVerse;
	protected bool TurnSpinnerOff = false;

	protected const int delayOnParameterSet = 600;
	protected const int delayBCVSelected = 600;

	// OT
	private List<Data.BookChapterWithOT>? verses = null;
	protected List<VerseModelOT>? FilteredVersesOT { get; set; }

	// NT
	private List<Data.BookChapterNT>? versesNT = null;
	protected List<VerseModelNT>? FilteredVersesNT { get; set; }

	protected int CurrentScrollToScriptureId;
	private BookChapterVerseRecord BCV { get; set; } = null!;

	protected override async Task OnParametersSetAsync()
	{
		try
		{
			if (!string.IsNullOrEmpty(BookAbrv))
			{

				ResolveBCV(BookAbrv, Chapter, Verse, scrollTarget: 0);

				// Test:
				//ResolveBCV("Foo", Chapter, Verse, scrollTarget: Verse); // Test: invalid book
				//ResolveBCV("Gen", 99, Verse, scrollTarget: Verse); // Test: chapter out of range
				//ResolveBCV("Gen", 1, 9999, scrollTarget: Verse); // Test: verse out of range
			}
			else
			{
				CurrentAbrvChapterVerse = State!.AppState!.BookChapterState!.GetACV();
				ResolveBCV(
						CurrentAbrvChapterVerse.Abrv,
						CurrentAbrvChapterVerse.Chapter,
						CurrentAbrvChapterVerse.Verse,
						scrollTarget: CurrentAbrvChapterVerse.ScriptureId);
			}

			if (BCV.BibleBook!.IsHebrewBible)
			{
				await Task.Delay(delayOnParameterSet);
				verses = await dbOT!.GetBookChapterOT(bookID: BCV.BibleBook!.Value, chapter: BCV.Chapter);
				FilteredVersesOT = GetBookChapterVersesOT();
			}
			else
			{
				await Task.Delay(delayOnParameterSet);
				versesNT = await dbNT!.GetBookChapterNT(bookID: BCV.BibleBook!.Value, chapter: BCV.Chapter);
				FilteredVersesNT = GetBookChapterVersesNT();
				//Logger!.LogWarning("{Method}, {errMsg}", nameof(OnParametersSetAsync), $"FilteredVersesNT.Count: {FilteredVersesNT.Count()}");
			}
			
			await SetFocusToElement();
		}
		catch (Exception ex)
		{
			ProcessError!.LogErrorWithMessage(ex, nameof(Index), nameof(OnParametersSetAsync), Nav.Bible, "");
		}
		finally
		{
			TurnSpinnerOff = true;
		}

	}

	private void ResolveBCV(string abrv, int chapter, int verse, int scrollTarget)
	{
		var (errMsg, _value) = BibleBookDictionary.GetId(abrv);
		if (!string.IsNullOrEmpty(errMsg))
		{
			Logger!.LogWarning("{Method}, {errMsg}", nameof(ResolveBCV), errMsg);
			ProcessError!.ShowToast(errMsg, ToastLevel.Warning);
			throw new InvalidOperationException(errMsg);
		}

		if (BibleBook.TryFromValue(_value, out BibleBook? bibleBook))
		{
			BCV = new BookChapterVerseRecord(bibleBook, chapter, verse);
			if (scrollTarget != 0)
			{
				CurrentScrollToScriptureId = scrollTarget;
			}
			else
			{
				CurrentScrollToScriptureId = BCV.ScriptureId;
			}
		}
		else
		{
			Logger!.LogWarning("{Method}, BibleBook.TryFromValue failed", nameof(ResolveBCV));
			ProcessError!.ShowToast("BibleBook.TryFromValue failed", ToastLevel.Error);
			throw new InvalidOperationException("BibleBook.TryFromValue failed");
		}
	}

	protected List<VerseModelOT> GetBookChapterVersesOT()
	{
		return verses!
				.OrderBy(o => o.Header.ID)
				.Select(bc => bc.MapFromBookChapterOT(BCV!.BibleBook!.Value, BCV.Chapter))
				.ToList();
	}

	protected List<VerseModelNT> GetBookChapterVersesNT()
	{
		return versesNT!
				.OrderBy(o => o.Header.ID)
				.Select(bc => bc.MapFromBookChapterNT(BCV!.BibleBook!.Value, BCV.Chapter))
				.ToList();
	}

	#region EventCallback Return Logic

	private string? TextFilter;
	private void ReturnedFilterSelected(FilterRecord filter)
	{
		TextFilter = !string.IsNullOrEmpty(filter.Description) ? filter.Description : null;
	}

	private void ReturnedClearAction()
	{
		currentAction = null;
		TextFilter = null;

		if (BCV.BibleBook!.IsHebrewBible)
		{
			FilteredVersesOT = GetBookChapterVersesOT();
		}
		else
		{
			FilteredVersesNT = GetBookChapterVersesNT();
		}
	}


	private void CloseModal()
	{
		currentAction = null;
	}

	private void ReturnedParashaClosed()
	{
		currentAction = null;
		if (BCV.BibleBook!.IsHebrewBible)
		{
			FilteredVersesOT = GetBookChapterVersesOT();
		}
		else
		{
			FilteredVersesNT = GetBookChapterVersesNT();
		}
	}

	//ToDo: same code as above [ReturnedParashaClosed], consider unifying
	private void ReturnedFilteredClosed()
	{
		currentAction = null;

		if (BCV.BibleBook!.IsHebrewBible)
		{
			FilteredVersesOT = GetBookChapterVersesOT();
		}
		else
		{
			FilteredVersesNT = GetBookChapterVersesNT();
		}
	}

	private async Task ReturnedTOC(ActionComponents.VerseAndID rec)
	{
		CurrentScrollToScriptureId = rec.ID;
		CurrentVerse = rec.Verse;
		BCV = BCV with { Verse = CurrentVerse };
		await SetFocusToElement();
		currentAction = null;
	}

	private async Task ReturnedBCVSelected(BookChapterVerseRecord bcv)
	{
		currentAction = null;
		BCV = bcv;

		try
		{
			// show spinner: clear filtered list so IsLoading expression becomes true
			TurnSpinnerOff = false;
			if (BCV.BibleBook!.IsHebrewBible)
			{
				FilteredVersesOT = null;
			}
			else
			{
				FilteredVersesNT = null;
			}
			StateHasChanged(); // force render so `RCL.Components.LoadingBookChapter` is reloaded and `torah-spinner` is displayed

			await Task.Delay(delayBCVSelected);
			if (BCV.BibleBook!.IsHebrewBible)
			{
				verses = await dbOT!.GetBookChapterOT(bcv.BibleBook!.Value, bcv.Chapter);
				FilteredVersesOT = GetBookChapterVersesOT();
			}
			else
			{
				versesNT = await dbNT!.GetBookChapterNT(bcv.BibleBook!.Value, bcv.Chapter);
				FilteredVersesNT = GetBookChapterVersesNT();
			}
		}
		catch (Exception ex)
		{
			ProcessError!.LogErrorWithMessage(ex, nameof(Index), nameof(ReturnedBCVSelected), Nav.Bible, $"called: {nameof(dbOT.GetBookChapterOT)}");
			return;
		}
		finally
		{
			TurnSpinnerOff = true;
		}

		CurrentScrollToScriptureId = bcv.ScriptureId;
		CurrentVerse = bcv.Verse;
		await SetFocusToElement();
	}

	protected Footers.ButtonType? currentAction = null;
	private List<VerseModelOT>? ParashaVerses { get; set; }

	private async Task ReturnedButtonType(Footers.ButtonType action)
	{
		currentAction = action;
		await Task.CompletedTask;
	}

	protected int CurrentVerse;

	#endregion

	// Called by: ReturnedTOC, ReturnedBCVSelected
	private async Task SetFocusToElement()
	{
		if (_module is not null)
		{
			await _module.InvokeVoidAsync(JS.FunctionScrollTo, $"verse-{CurrentScrollToScriptureId}");
			await _module.InvokeVoidAsync(JS.FunctionSetFocus, $"verse-{CurrentScrollToScriptureId}");
		}
	}


	#region EventCallback Return Toolbar Logic

	//protected UserSettingsDTO? UserSettings { get; set; }
	private void ReturnUserSettingsDTO(UserSettingsDTO userSettingsDTO)
	{
		//Logger!.LogDebug("{Method}, UserSettingsDTO: {UserSettingsDTO}", nameof(ReturnUserSettingsDTO), userSettingsDTO);
		//UserSettings = userSettingsDTO;
		ProcessError!.ShowToast("User settings updated", ToastLevel.Success);
	}


	protected MenuItem? CurrentModalToShow { get; set; }
	private void ReturnedMenuItemId(int id)
	{
		//Logger!.LogDebug("{Method}, id: {Id}", nameof(ReturnedMenuItemId), id);
		if (MenuItemEnums.TryFromValue(id, out MenuItemEnums? menuItem))
		{
			CurrentModalToShow = menuItem;
		}
		else
		{
			Logger!.LogWarning("{Method}, Invalid MenuItem: {Id}", nameof(ReturnedMenuItemId), id);
			ProcessError!.ShowToast($"Invalid MenuItem: {id}", ToastLevel.Error);
		}
	}

	private void ReturnedCloseEvent()
	{
		CurrentModalToShow = null;
		//Logger!.LogDebug("{Method}, CurrentModalToShow set to null", nameof(ReturnedCloseEvent));
	}

	#endregion

	#region JavaScript Setup and Teardown

	private IJSObjectReference? _module;
	protected bool _firstRendered = false;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && !_firstRendered)
		{
			try
			{
				_module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", JS.Path);
				if (_module != null)
				{
					await _module.InvokeVoidAsync(JS.FunctionScrollTo, $"verse-{CurrentScrollToScriptureId}");
					await _module.InvokeVoidAsync(JS.FunctionSetFocus, $"verse-{CurrentScrollToScriptureId}");
				}
			}
			catch (Exception ex)
			{
				ProcessError!.LogErrorWithMessage(ex, nameof(Index), nameof(OnAfterRenderAsync), Nav.Bible
				, $"failed to load {nameof(JS.FunctionScrollTo)} or {nameof(JS.FunctionSetFocus)}");
			}
			_firstRendered = true;
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (_module is not null)
		{
			await _module.DisposeAsync();
		}
	}

	#endregion
}
