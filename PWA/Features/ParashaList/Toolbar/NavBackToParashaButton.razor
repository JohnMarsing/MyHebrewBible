@using ParashaEnums = RCL.Features.Parasha.Enums

@inject NavigationManager NavigationManager

<div class="@MediaQuery.Xs.DivClass">
	<button @onclick="ButtonClicked" class="btn btn-primary btn-sm" title="return to current @Nav.Parasha.Title"
					href="@Nav.Parasha.Index">
		<i class="@Nav.Parasha.Icon"></i>
	</button>

</div>

<div class="@MediaQuery.SmOrMdOrLgOrXl.DivClass">
	<button @onclick="ButtonClicked" class="btn btn-primary" title="return to current @Nav.Parasha.Title"
					href="@Nav.Parasha.Index">
		<i class="@Nav.Parasha.Icon"></i>
	</button>

</div>


@code {
	
	[Parameter, EditorRequired] public string? ReturnUrl { get; set; }

	private void ButtonClicked()
	{
		NavigationManager!.NavigateTo(ReturnUrl!);
	}
}
