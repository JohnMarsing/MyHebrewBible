
<nav class="navbar navbar-expand bg-primary-subtle">

	<div class="px-1">
		@Sitemap
	</div>


	<div class="collapse navbar-collapse justify-content-start">
		<div class="">
			@JustifyStart
		</div>
	</div>

	<div class="collapse navbar-collapse justify-content-center">
		@PrevButtonDiv
		<div class="px-0 px-sm-1">
			@PickerDiv
		</div>
		@NextButtonDiv
	</div>

	<div class="collapse navbar-collapse justify-content-end pe-1 pe-sm-2">
		@JustifyEnd
	</div>
</nav>

@code {
	[Parameter, EditorRequired] public RenderFragment? Sitemap { get; set; }
	[Parameter, EditorRequired] public RenderFragment? JustifyStart { get; set; }
	[Parameter, EditorRequired] public RenderFragment? PrevButtonDiv { get; set; }
	[Parameter, EditorRequired] public RenderFragment? PickerDiv { get; set; }
	[Parameter, EditorRequired] public RenderFragment? NextButtonDiv { get; set; }
	[Parameter, EditorRequired] public RenderFragment? JustifyEnd { get; set; }
}
