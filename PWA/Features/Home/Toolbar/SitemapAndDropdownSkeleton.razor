@using Page = PWA.Enums.Nav

@inject NavigationManager NavigationManager

<div class="btn-group " role="group" aria-label="Vertical button group">

	<button @onclick="ButtonClick" class="btn btn-primary" type="button" title="@Page.Sitemap.Title">
		<i class="@Page.Sitemap.Icon"></i>
	</button>

	<button type="button" class="btn btn-info dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
		<span class="visually-hidden">Toggle Dropdown</span>
	</button>

	<div class="btn-group-vertical btn-group" role="group" aria-label="Vertical button group">

		<ul class="dropdown-menu">

			<li class="fw-bold dropdown-header">Recent</li>
			@Recent

			<li><hr class="dropdown-divider"></li>

			<li class="fw-bold dropdown-header">Parasha</li>

			<li class="dropdown-item">
				@Parashot
			</li>
		</ul>

	</div>

</div>


@code {
	[Parameter, EditorRequired] public RenderFragment? Recent { get; set; }
	[Parameter, EditorRequired] public RenderFragment? Parashot { get; set; }

	private void ButtonClick()
	{
		NavigationManager!.NavigateTo($"{Page.Sitemap.Index}");
	}

}

