@using PWA.Features.Bible
@using PWA.Features.Bible.Toolbar
@using RCL.Enums

@inject NavigationManager NavigationManager

<div class="list-group">

	@if (CurrentAbrvChapterVerse is not null)
	{
		<a href="@Nav.Bible.Index"
			 class="list-group-item list-group-item-action active"
			 aria-current="true"
			 @onclick:preventDefault="true"
			 @onclick="() => OpenBibleAsync(CurrentAbrvChapterVerse)">
			@Format(CurrentAbrvChapterVerse)
		</a>
	}
	else
	{
		<a href="#" class="list-group-item list-group-item-info" aria-current="true">
			CurrentAbrvChapterVerse is null
		</a>
	}

	@foreach (var item in RecentList)
	{
		<a href="@Nav.Bible.Index"
			 class="list-group-item list-group-item-action"
			 @onclick:preventDefault="true"
			 @onclick="() => OpenBibleAsync(item)">
			@Format(item)
		</a>
	}

	<a href="#" class="list-group-item list-group-item-info" aria-current="true">
		Recent List
	</a>

	@if (currentReading is not null && currentReading.BritVerses is not null)
	{
		foreach (var item in currentReading.BritVerses)
		{
			var (chapterB, verseB) = RCL.Features.Parasha.Helpers.CalculateChapterAndVerse(item.BibleBook, item.BegId);
			ParashaList.Add(new BookChapterVerseHistory(item.BibleBook.Value, chapterB, verseB));
		}
	}
	else
	{
		<a href="#" class="list-group-item list-group-item-success" aria-current="true">
			currentReading is null
		</a>
	}


</div>


@code {
	[CascadingParameter] public CascadingAppState? State { get; set; }

	

	private AbrvChapterVerse? CurrentAbrvChapterVerse;
	private List<BookChapterVerseHistory> RecentList { get; set; } = [];
	private List<BookChapterVerseHistory> ParashaList { get; set; } = [];

	protected override async Task OnInitializedAsync()
	{
		PopulateParashaList();
		// try
		// {
		// 	PopulateParashaList();
		// }
		// catch (Exception ex)
		// {
		// 	ProcessError!.LogErrorWithMessage(ex, nameof(Index), nameof(OnInitializedAsync), Nav.HealthCheckDatabase, $"called: {nameof(db.GetSqliteVersion)}");
		// }
		// finally { TurnSpinnerOff = true;  }
	}


	private static string Format(AbrvChapterVerse item) => $"{item.Abrv} {item.Chapter}:{item.Verse}";

	private static string Format(BookChapterVerseHistory item) =>
		$"{BibleBook.FromValue(item.BibleBookId).Abrv} {item.Chapter}:{item.Verse}";

	protected RCL.Features.Parasha.Enums.Triennial? currentReading;
	private void PopulateParashaList()
	{
		ParashaList.Clear();

		currentReading = RCL.Features.Parasha.Helpers.GetCurrentReading();
		if (currentReading is null)
		{
			return;
		}

		var (chapter, verse) = RCL.Features.Parasha.Helpers.CalculateChapterAndVerse(
			currentReading.TorahVerse.BibleBook,
			currentReading.TorahVerse.BegId);

		ParashaList.Add(new BookChapterVerseHistory(
			currentReading.TorahVerse.BibleBook.Value,
			chapter,
			verse));

		if (currentReading.HaftorahVerses is not null)
		{
			foreach (var item in currentReading.HaftorahVerses)
			{
				var (chapterH, verseH) = RCL.Features.Parasha.Helpers.CalculateChapterAndVerse(item.BibleBook, item.BegId);
				ParashaList.Add(new BookChapterVerseHistory(item.BibleBook.Value, chapterH, verseH));
			}
		}

		if (currentReading.BritVerses is not null)
		{
			foreach (var item in currentReading.BritVerses)
			{
				var (chapterB, verseB) = RCL.Features.Parasha.Helpers.CalculateChapterAndVerse(item.BibleBook, item.BegId);
				ParashaList.Add(new BookChapterVerseHistory(item.BibleBook.Value, chapterB, verseB));
			}
		}
	}

	private async Task OpenBibleAsync(AbrvChapterVerse acv)
	{
		await State!.AppState!.BookChapterState!.UpdateACV(acv);
		NavigationManager.NavigateTo(Nav.Bible.Index);
	}

	private async Task OpenBibleAsync(BookChapterVerseHistory bcv)
	{
		if (!BibleBook.TryFromValue(bcv.BibleBookId, out BibleBook? bibleBook) || bibleBook is null)
		{
			return;
		}

		var acv = new AbrvChapterVerse(
			bibleBook.Abrv,
			bcv.Chapter,
			bcv.Verse,
			bcv.Verse != 1,
			BibleBookHelper.GetScriptureId(bibleBook, bcv.Chapter, bcv.Verse),
			PWA.Features.Bible.Helper.LastVerseCount(bibleBook, bcv.Chapter));

		await State!.AppState!.BookChapterState!.UpdateACV(acv);
		NavigationManager.NavigateTo(Nav.Bible.Index);
	}

}
