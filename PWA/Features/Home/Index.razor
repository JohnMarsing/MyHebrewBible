@page "/"

@using RCL.Enums
@using PWA.Features.Bible.Toolbar

@inject NavigationManager NavigationManager
@inject IToastService? Toast 

<PageTitle>@Nav.Home.Title</PageTitle>

<header class="">
	<Buttons />
</header>

<section class="px-1">

	<div class="text-center">
		<img src="/images/MyHebrewBible.svg"
				 class="img-fluid title-logo home-logo"
				 alt="My Hebrew Bible" />
	</div>
	
	<div class="card mt-2 mb-4 mx-auto" style="width: 18rem;">
		<div class="card-header bg-info">
			<SearchForm ButtonClicked="OnSearchFormGo" />
			<div class="fs-4">Book/Chapter/Verse</div>
		</div>
		
	</div>
	

 	<BcvCardTemplate Button="Enums.Button.LastBCV" MarginXClass="mx-auto">
			<ListGroupRF>
				<LastBCV OnItemClicked="NavigateToItem" />
			</ListGroupRF>
	</BcvCardTemplate>

	<div class="d-flex flex-column flex-sm-row justify-content-sm-evenly align-items-center">
		<div>
			<BcvCardTemplate Button="Enums.Button.RecentList" MarginXClass="mx-0">
				<ListGroupRF>
					<RecentList OnItemClicked="NavigateToItem" />
				</ListGroupRF>
			</BcvCardTemplate>
		</div>

		<div>
			<BcvCardTemplate Button="Enums.Button.ParashaList" MarginXClass="mx-0">
				<ListGroupRF>
					<ParashaList OnItemClicked="NavigateToItem" />
				</ListGroupRF>
			</BcvCardTemplate>
		</div>
	</div>

</section>

<footer class=""><DefaultFooter /></footer>

@code
{
	private void NavigateToItem(BookChapterVerseHistory item)
	{
		if (!BibleBook.TryFromValue(item.BibleBookId, out BibleBook? bibleBook) || bibleBook is null)
		{
			Toast!.ShowWarning("Invalid input");
			return;
		}
		NavigationManager.NavigateTo($"{Nav.Bible.Index}/{bibleBook.Abrv}/{item.Chapter}/{item.Verse}");
	}


	private void OnSearchFormGo(BookChapterVerseRecord record)
	{
		if (record.BibleBook is null)
		{ 
			Toast!.ShowWarning("Invalid input"); 
		return;
		}
		NavigationManager.NavigateTo($"{Nav.Bible.Index}/{record.BibleBook.Abrv}/{record.Chapter}/{record.Verse}");
	}
}

