@page "/"

<PageTitle>@Nav.Home.Title</PageTitle>

<header class="">
	<Buttons />
</header>

<section class="px-1">

	<div class="text-center">
		<img src="/images/MyHebrewBible.svg"
				 class="img-fluid title-logo home-logo"
				 alt="My Hebrew Bible" />
	</div>

	<p class="text-center text-muted">Book/Chapter/Verse</p>

	<BcvCardTemplate Button="Enums.Button.LastBCV" MarginXClass="mx-auto">
			<ListGroupRF>
				<LastBCV />
			</ListGroupRF>
	</BcvCardTemplate>

	<div class="d-flex flex-column flex-sm-row justify-content-sm-evenly align-items-center">
		<div>
			<BcvCardTemplate Button="Enums.Button.RecentList" MarginXClass="mx-0">
				<ListGroupRF>
					<RecentList />
				</ListGroupRF>
			</BcvCardTemplate>
		</div>

		<div>
			<BcvCardTemplate Button="Enums.Button.ParashaList" MarginXClass="mx-0">
				<ListGroupRF>
					<ParashaList />
				</ListGroupRF>
			</BcvCardTemplate>
		</div>
	</div>

</section>

<footer class=""><DefaultFooter /></footer>

