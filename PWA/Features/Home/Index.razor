@page "/"

@using SqliteWasmBlazor




<PageTitle>@Nav.Home.Title</PageTitle>

<header class="">
	<Buttons />
</header>

<section class="px-1">

	<div class="text-center">
		<img src="/images/MyHebrewBible.svg"
				 class="img-fluid title-logo home-logo"
				 alt="My Hebrew Bible" />
	</div>

	<div class="card bg-warning-subtle mb-2">

		<div class="card-header bg-warning ">
			<h5 class="text-center">Book/Chapter List</h5>
		</div>

		<div class="card-body my-3">
			<div class="text-center">
				<a class="btn btn-secondary btn-lg" href="@Nav.Bible.Index">
					<i class="fa fa-book"></i>
					Bible
					<i class="fas fa-chevron-right"></i>
				</a>
			</div>
		</div>

	</div>

</section>

<footer class=""><DefaultFooter /></footer>

@code
{
	[Inject] private ISqliteWasmDatabaseService DbService { get; set; } = default!;
	[Inject] private ILogger<Index> Logger { get; set; } = default!;
	[Inject] private IToastService Toast { get; set; } = default!;
	[Inject] private PWA.HealthChecks.Database.Data.IRepository? db { get; set; } = default!;

	[CascadingParameter] private ProcessError? ProcessError { get; set; }


	string? SqliteVersion = null;
	protected override async Task OnInitializedAsync()
	{
		try
		{
			SqliteVersion = await db!.GetSqliteVersion();
			if (SqliteVersion is null)
			{
				Toast!.ShowWarning($"SQLite version not found (◡︵◡)");
			}
			//PopulateParashaList();
		}
		catch (Exception ex)
		{
			ProcessError!.LogErrorWithMessage(ex, nameof(Index), nameof(OnInitializedAsync), Nav.HealthCheckDatabase, $"called: {nameof(db.GetSqliteVersion)}");
		}
		//finally { TurnSpinnerOff = true;  }
	}

	
}

