

<div class="d-flex justify-content-start">
	@foreach (var item in Enums.Action.List
		.Where(w => w.ActionGroupEnum == ActionGroup)
		.OrderBy(o => o.Value))
	{
		<div>
			<button class="btn @item.BtnColor btn-xs rounded rounded-3 me-1"
							@onclick="() => ButtonClick(item)"
							title="@item.Title">
				<i class="@item.Icon"></i>
			</button>
			<br />
			<small><sup><span class="">@item.Label</span></sup></small>
		</div>
	}
</div>

@code {
	[Parameter, EditorRequired] public Enums.ActionGroupEnum ActionGroup { get; set; }
	[Parameter, EditorRequired] public EventCallback<Enums.Action> OnActionSelected { get; set; }

	private void ButtonClick(Enums.Action action)
	{
		OnActionSelected.InvokeAsync(action);
	}

}
