@using System.ComponentModel.DataAnnotations

@implements IAsyncDisposable

@* Modal backdrop *@
<div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="goToVerseModalLabel">
	<div class="modal-dialog" role="document">
		<div class="modal-content">

			<div class="modal-header">
				<h5 class="modal-title" id="goToVerseModalLabel">Go to Verse</h5>
				<button type="button" class="btn-close" aria-label="Close" @onclick="HandleCancel"></button>
			</div>

			<div class="modal-body">
				<EditForm Model="@VM" OnValidSubmit="HandleValidSubmit">
					<DataAnnotationsValidator />

					<div class="row mb-2 align-items-center">
						<label for="verseNumber" class="col-4 col-form-label">Verse</label>
						<div class="col-5">
							<input type="number" 
							 id="verseNumber"
							 class="form-control form-control-sm"
							 @bind="VM.VerseNumber"
							 @ref="verseNumberInput"
							 placeholder="@($"1 – {VM.MaxVerse}")"
							 min="1"
							 max="@VM.MaxVerse" />
						</div>
						<div class="col-3">
							<button type="submit" class="btn btn-sm btn-primary w-100" disabled="@(!VM.IsValid())">Go <i class="fas fa-chevron-right"></i></button>
						</div>
					</div>

					<ValidationMessage For="() => VM.VerseNumber" />
					<ValidationSummary />

				</EditForm>
			</div>

		</div>
	</div>
</div>
<div class="modal-backdrop fade show"></div>

@code {
	[Parameter, EditorRequired] public BookChapterVerseRecord BCV { get; set; }
	[Parameter, EditorRequired] public EventCallback<VerseAndID> OnSelected { get; set; }
	[Parameter, EditorRequired] public EventCallback OnCancel { get; set; }

	private GoToVerseFormVM VM { get; set; } = new();

	protected override void OnParametersSet()
	{
		VM = new GoToVerseFormVM { MaxVerse = BCV!.BibleBook!.LastVerses[BCV.Chapter - 1] };  
	}

	private async Task HandleValidSubmit()
	{
		if (VM.VerseNumber.HasValue)
		{
			var rec = new VerseAndID(VM.VerseNumber.Value, RCL.Enums.BibleBookHelper.GetScriptureId(BCV.BibleBook!, BCV.Chapter, VM.VerseNumber.Value));
			await OnSelected.InvokeAsync(rec);
		}
	}

	private async Task HandleCancel()
	{
		await OnCancel.InvokeAsync();
	}

	public class GoToVerseFormVM
	{
		public int MaxVerse { get; set; }

		[Required(ErrorMessage = "Verse number is required")]
		[Range(1, int.MaxValue, ErrorMessage = "Verse must be at least 1")]
		public int? VerseNumber { get; set; }

		public bool IsValid()
		{
			return VerseNumber.HasValue 
				&& VerseNumber.Value >= 1 
				&& VerseNumber.Value <= MaxVerse;
		}
	}

	[Inject] public IJSRuntime JS { get; set; } = default!;

	private ElementReference verseNumberInput;
	private IJSObjectReference? module;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			module = await JS.InvokeAsync<IJSObjectReference>("import", 
				"./Features/ScrollSpy/ActionComponents/GoToVerse/GoToVerseForm.razor.js");
			await module.InvokeVoidAsync("focusElement", verseNumberInput);
		}
	}

	async ValueTask IAsyncDisposable.DisposeAsync()
	{
		if (module is not null)
		{
			await module.DisposeAsync();
		}
	}
}

