@using PWA.Features.ScrollSpy
@using PWA.Components.Toolbar

@using PWA.Features.Bible.Enums
@using MenuItemEnums = PWA.Features.Bible.Enums.MenuItem
@* @using ToolbarEnums = PWA.Features.ScrollSpy.Toolbar.Enums *@

@inject ILogger<Buttons>? Logger
@inject IToastService? Toast

<PageTitle>@Nav.BibleBeta.Title</PageTitle>

<nav class="navbar navbar-expand bg-primary-subtle">

	<div class="collapse navbar-collapse justify-content-start">

		<div class="ps-1">
			<SitemapButton />
		</div>
	</div>

	@if (BCV is not null)
	{
		<div class="@MediaQuery.Xs.DivClass">
			<span class="fs-5 pt-1 fw-bold text-success">@BCV!.BibleBook!.Title @BCV.Chapter</span>
			<span>&nbsp;&nbsp;&nbsp;</span>
			<span class="hebrew30">@BCV.BibleBook.NameInHebrew</span>

		</div>
		<div class="@MediaQuery.SmOrMdOrLgOrXl.DivClass">
			<span class="fs-1 pt-2 fw-bold">@BCV!.BibleBook!.Title @BCV.Chapter</span>
			<span>&nbsp;&nbsp;&nbsp;</span>
			<span class="hebrew36">@BCV.BibleBook.NameInHebrew</span>
		</div>
	}


	<div class="collapse navbar-collapse justify-content-end">
		<div class="pe-1">
			
			<div class="@MediaQuery.Xs.DivClass">
				<MenuTemplate Items="menuItems" BtnSize="btn-sm" OnItemSelected="ReturnedMenuItemPassThrough" />
			</div>
			<div class="@MediaQuery.SmOrMdOrLgOrXl.DivClass">
				<MenuTemplate Items="menuItems" OnItemSelected="ReturnedMenuItemPassThrough" />
			</div>

		</div>

	</div>

</nav>

@code {
	[Parameter, EditorRequired] public BookChapterVerseRecord? BCV { get; set; }
	[Parameter, EditorRequired] public EventCallback<int> OnMenuItemSelectedPassThrough { get; set; }

	private List<Dictionary<int, string?>> menuItems = MenuItemEnums.List
		.Select(item => new Dictionary<int, string?> { { item.Value, item.Title } })
		.ToList();

	private void ReturnedMenuItemPassThrough(int menuItem)
	{
		//		Toast!.ShowWarning($"ReturnedMenuItemPassThrough {menuItem}");
		OnMenuItemSelectedPassThrough.InvokeAsync(menuItem);
	}
}
