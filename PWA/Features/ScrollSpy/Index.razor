@page "/BibleBeta"

@using Dapper;
@using PWA.Features.ScrollSpy.Data

@using DirEnums = PWA.Components.Report.Enums.VerticalDirection
@using DirHelper = PWA.Components.Report.Enums.VerticalDirectionHelper
@using PWA.Features.ScrollSpy.ActionComponents.Find
@using PWA.Features.ScrollSpy.ActionComponents.ToC


@inject PWA.Features.ScrollSpy.Data.IRepository? db;
@inject ILogger<Index>? Logger
@inject IToastService? Toast

@inject IJSRuntime JSRuntime
@implements IAsyncDisposable


<header>
	<Buttons />
</header>

<LoadingComponent IsLoading="FilteredVerses == null" TurnSpinnerOff="TurnSpinnerOff">

	<section class="px-1">

		@foreach (var item in FilteredVerses!.OrderBy(o => o.ID))
		{
			<TitleSubtitleSS Title="@item.DescH" Subtitle="@item.DescD" BCV="" />
			<div id="verse-@item.ID" tabindex="0" @onkeydown="HandleKeyDown">
				<ParagraphSS BookAndChapter="GetBookAndChapter(item.BookID, item.Chapter)"
										 Verse="item"
										 ScrollToScriptureId="CurrentScrollToScriptureId"
										 HighlightText="@_highlightText" />
			</div>
		}
	</section>

	<footer class="sticky-bottom">
		<StickyFooter Title="@BookAndChapter?.Title" TitleSuffix="@TitleSuffix"
									OnActionSelected="ReturnedAction" OnClearClicked="ReturnedClearAction" />
	</footer>

</LoadingComponent>

@if (currentAction is not null)
{
	@if (currentAction == Enums.Action.Toc)
	{
		<SubtitleModal Data="FilteredVerses?.ToTableOfContentMapping().ToList()" OnSelected="ReturnedTOC" OnCancel="CloseModal" />
	}
	else if (currentAction == Enums.Action.Find)
	{
		<TextOrStrongsForm OnFilterSelected="ReturnedFilterSelected" OnCancel="CloseModal" />
	}
	else if (currentAction == Enums.Action.ListVerses)
	{
		<TextOrStrongsForm OnFilterSelected="ReturnedFilterSelected" OnCancel="CloseModal" />
	}

}


@code {

	private async Task ReturnedTOC(ReturnedRecord rec)
	{
		CurrentScrollToScriptureId = rec.ID;
		CurrentVerse = rec.Verse;
		await SetFocusToElement();
		currentAction = null;
	}

	#region Filter


	/*
	ToDo: Consider a new feature; what if you persisted the last action
	- maybe pre-populate the modal/form with the last search? Would that be helpful or just annoying?
		- if you could persist a list, then you could show a dropdown of recent searches/actions. next to the Find button not unlike the B/C History
 */
	private string? TitleSuffix;
	private string? _highlightText;

	private void ReturnedFilterSelected(FilterRecord filter)
	{
		TitleSuffix = !string.IsNullOrEmpty(filter.Description) ? filter.Description : null;

		_highlightText = filter.SearchText;
		ApplyFilter(filter);

		currentAction = null;
	}

	private void ApplyFilter(FilterRecord filter)
	{
		var hasText = !string.IsNullOrWhiteSpace(filter.SearchText);

		if (!hasText)
		{
			FilteredVerses = GetBookChapterVerses();
			return;
		}

		FilteredVerses = GetBookChapterVerses()
			.Where(v => v.KJV?.Contains(filter.SearchText!, StringComparison.OrdinalIgnoreCase) ?? false)
			.ToList();
	}

	private void CloseModal()
	{
		currentAction = null;
	}

	private void ReturnedClearAction()
	{
		currentAction = null;
		_highlightText = null;
		TitleSuffix = null;
		FilteredVerses = GetBookChapterVerses();
	}
	#endregion


	#region Non Filter
	private void ReturnedOuline(int id)
	{
		//Toast!.ShowInfo($"Outline Selected: {id}");
	}

	private void ReturnedVerse(int id)
	{
		//Toast!.ShowInfo($"Verse Selected: {id}");
	}

	private void ReturnedBookChapterVerse(BookChapterVerseRecord bcv)
	{
		//Toast!.ShowInfo($"BookChapterVerse Selected: {bcv}");
	}
	#endregion

	protected Enums.Action? currentAction = null;
	private async Task ReturnedAction(Enums.Action action)
	{
		currentAction = action;

		if (currentAction == Enums.Action.PrevVerse || currentAction == Enums.Action.NextVerse)
		{
			SetScriptureIdAndVerse(currentAction == Enums.Action.PrevVerse ? DirEnums.Up : DirEnums.Down);
			await SetFocusToElement();
		}
		/*
		else if(currentAction == Enums.Action.ListVerses)
		{
			Toast!.ShowSuccess($"currentAction: {currentAction}, inside {nameof(ReturnedAction)}");
			}
		*/
	}

	private void SetScriptureIdAndVerse(DirEnums dirEnums)
	{
		var (errMsg, verse, _scriptureId) =
			DirHelper.GetVerseAndScriptureIdSS(dirEnums, CurrentScrollToScriptureId, FilteredVerses!);

		if (!String.IsNullOrEmpty(errMsg))
		{
			Toast!.ShowWarning(errMsg);
			return;
		}
		else
		{
			CurrentScrollToScriptureId = _scriptureId;
			CurrentVerse = verse;
		}

		if (CurrentScrollToScriptureId != CurrentAbrvChapterVerse!.ScriptureId)
		{
			CurrentAbrvChapterVerse = CurrentAbrvChapterVerse!
				with
			{ Verse = verse, ScriptureId = CurrentScrollToScriptureId };
		}
	}


	protected int CurrentScrollToScriptureId;
	protected int CurrentVerse;

	protected BookAndChapter GetBookAndChapter(int bookId, int chapter)
	{
		return new BookAndChapter(RCL.Enums.BibleBook.FromValue(bookId), chapter);
	}

	protected Bible.AbrvChapterVerse CurrentAbrvChapterVerse = Bible.AbrvChapterVerse.Default;

	protected bool TurnSpinnerOff = false;
	private List<BookChapterWithAT>? verses = null;
	private BookAndChapter? BookAndChapter { get; set; }

	protected List<ReportModel>? FilteredVerses { get; set; }

	protected override async Task OnInitializedAsync()
	{
		try
		{
			verses = await db!.GetBookChapterWithAT(1, 1);
			BookAndChapter = new BookAndChapter(RCL.Enums.BibleBook.FromValue(1), 1);
			CurrentScrollToScriptureId = CurrentAbrvChapterVerse.ScriptureId; // = 1;
			FilteredVerses = GetBookChapterVerses();
		}
		catch (Exception ex)
		{
			Logger!.LogError(ex, "{Method}", nameof(OnInitializedAsync));
		}
		finally
		{
			TurnSpinnerOff = true;
		}
	}

	protected List<ReportModel> GetBookChapterVerses()
	{
		return verses!
				.OrderBy(o => o.ID)
				.Select(bc => bc.ToReportModel(BookAndChapter!.BibleBook!.Value, BookAndChapter.Chapter))
				.ToList();
	}

	private async Task HandleKeyDown(KeyboardEventArgs e)
	{
		//Toast!.ShowWarning($"{nameof(HandleKeyDownSS)} called");
		var (valid, dirEnums) = DirHelper.IsKeyDownValid(e.Key);
		if (!valid) { return; }

		SetScriptureIdAndVerse(dirEnums!);
		await SetFocusToElement(); //Do I Need this???
	}

	private async Task SetFocusToElement()
	{
		if (_module is not null)
		{
			await _module.InvokeVoidAsync(JSFunctionSetFocus, $"verse-{CurrentScrollToScriptureId}");
		}
	}


	#region JavaScript Setup

	private IJSObjectReference? _module;
	protected bool _firstRendered = false;
	
	const string JSFunctionScrollTo = "scrollToElement";
	const string JSFunctionSetFocus = "setFocusToElement";

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && !_firstRendered)
		{
			try
			{
				_module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Features/ScrollSpy/Index.razor.js");
				if (_module != null)
				{
					await _module.InvokeVoidAsync(JSFunctionScrollTo, $"verse-{CurrentScrollToScriptureId}");
					await _module.InvokeVoidAsync(JSFunctionSetFocus, $"verse-{CurrentScrollToScriptureId}");
				}
			}
			catch (Exception ex)
			{
				Logger!.LogError(ex, "{Method} failed to load JS module or set focus", nameof(OnAfterRenderAsync));
			}
			_firstRendered = true;
		}
	}
	#endregion

	private async Task ReturnedSetFocus(int scriptureId)
	{
		if (_module is not null)
		{
			//Toast!.ShowWarning($"{nameof(ReturnedSetFocus)} Id: {scriptureId}");
			CurrentScrollToScriptureId = scriptureId;
			await _module.InvokeVoidAsync("setFocusToElement", $"verse-{scriptureId}");
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (_module is not null)
		{
			await _module.DisposeAsync();
		}
	}
}
