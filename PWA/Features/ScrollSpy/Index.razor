@page "/ScrollSpy"

@using Dapper;
@using PWA.Data;
@using PWA.Components.Report
@using ReportEnums = PWA.Components.Report.Enums
@using PWA.Data.Endpoints

@using DirEnums = PWA.Components.Report.Enums.VerticalDirection
@using DirHelper = PWA.Components.Report.Enums.VerticalDirectionHelper

@inject PWA.Features.Bible.Data.IRepository? db;
@inject ILogger<Index>? Logger
@inject IJSRuntime? JSRuntime
@inject IToastService? Toast

@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<header>
	<Buttons />
</header>


<LoadingComponent IsLoading="Verses == null" TurnSpinnerOff="TurnSpinnerOff">

	<section class="px-1">

		@foreach (var item in Verses!.OrderBy(o => o.ID))
		{
			<TitleSubtitle Title="@item.DescH" Subtitle="@item.DescD" BCV="" />
			<div id="verse-@item.ID" tabindex="0" @onkeydown="HandleKeyDownSS">
				<ParagraphSS BookAndChapter="GetBookAndChapter(item.BookID, item.Chapter)"
										 Verse="item"
										 ScrollToScriptureId="CurrentScrollToScriptureId" />
			</div>
		}
	</section>

	<section class="px-0">

		<nav class="navbar sticky-bottom bg-body-tertiary">
			<div class="container-fluid">
				<VerticalScrollSpy Verses="Verses!.Select(v => (v.Verse, v.ID)).ToList()"
													 SelectedVerseId="CurrentScrollToScriptureId"
													 OnSetFocus="ReturnedSetFocus" />
			</div>
		</nav>
	</section>
	
</LoadingComponent>


@code {
	protected int CurrentScrollToScriptureId;
	protected int CurrentVerse;

	protected BookAndChapter GetBookAndChapter(int bookId, int chapter)
	{
		return new BookAndChapter(RCL.Enums.BibleBook.FromValue(bookId), chapter);
	}

	protected Bible.AbrvChapterVerse CurrentAbrvChapterVerse = Bible.AbrvChapterVerse.Default;
	protected List<ReportModel>? Verses { get; set; }

	protected bool TurnSpinnerOff = false;
	private List<BookChapterWithAT>? verses = null;
	private BookAndChapter? BookAndChapter { get; set; }

	protected override async Task OnInitializedAsync()
	{
		try
		{
			verses = await db!.GetBookChapterWithAT(1, 1);
			BookAndChapter = new BookAndChapter(RCL.Enums.BibleBook.FromValue(1), 1);
			CurrentScrollToScriptureId = CurrentAbrvChapterVerse.ScriptureId; // = 1;
			Verses = GetBookChapterVerses();
		}
		catch (Exception ex)
		{
			Logger!.LogError(ex, "{Method}", nameof(OnInitializedAsync));
		}
		finally
		{
			TurnSpinnerOff = true;
		}
	}

	protected List<ReportModel> GetBookChapterVerses()
	{
		return verses!
				.OrderBy(o => o.ID)
				.Select(Home => MapToReportModel(Home))
				.ToList();
	}

	private ReportModel MapToReportModel(BookChapterWithAT bc)
	{
		return new ReportModel
		{
			ID = bc.ID,
			BCV = bc.BCV,
			Verse = bc.Verse,
			VerseOffset = bc.VerseOffset,
			KJV = bc.KJV,
			DescH = bc.DescH,
			DescD = bc.DescD,
			BookID = BookAndChapter!.BibleBook!.Value,
			Chapter = BookAndChapter.Chapter,

			WordPartList = bc.WordPartList?
			.Select(wp => new WordPart
			{
				Id = wp.Id,
				BCV = wp.BCV,
				BookID = wp.BookID,
				Chapter = wp.Chapter,
				Verse = wp.Verse,
				ScriptureID = wp.ScriptureID,
				WordCount = wp.WordCount,
				SegmentCount = wp.SegmentCount,
				WordEnum = wp.WordEnum,
				Hebrew1 = wp.Hebrew1,
				Hebrew2 = wp.Hebrew2,
				Hebrew3 = wp.Hebrew3,
				KjvWord = wp.KjvWord,
				Strongs = wp.Strongs,
				Transliteration = wp.Transliteration,
				FinalEnum = wp.FinalEnum
			})
			.ToList() ?? new()
		};
	}

	private async Task HandleKeyDownSS(KeyboardEventArgs e)
	{
		//Toast!.ShowWarning($"{nameof(HandleKeyDown)} called");
		var (valid, dirEnums) = DirHelper.IsKeyDownValid(e.Key);
		if (!valid) { return; }
		
		var (errMsg, verse, _scriptureId) =
			DirHelper.GetVerseAndScriptureIdSS(dirEnums!, CurrentScrollToScriptureId, Verses!);
		// DirHelper.GetVerseAndScriptureId

		if (!String.IsNullOrEmpty(errMsg))
		{
			Toast!.ShowWarning(errMsg);
			return;
		}
		else
		{
			CurrentScrollToScriptureId = _scriptureId;
			CurrentVerse = verse;
		}

		//CalledBy == Enums.CalledBy.BookChapter &&
		if (CurrentScrollToScriptureId != CurrentAbrvChapterVerse!.ScriptureId)
		{
			CurrentAbrvChapterVerse = CurrentAbrvChapterVerse!
				with
			{ Verse = verse, ScriptureId = CurrentScrollToScriptureId };
			//await State!.AppState!.BookChapterState!.UpdateACV(CurrentAbrvChapterVerse!);
		}

		//Do I Need this???
		if (_module is not null)
		{
			await _module.InvokeVoidAsync("setFocusToElement", $"verse-{CurrentScrollToScriptureId}");
		}


	}

	private IJSObjectReference? _module;
	protected bool _firstRendered = false;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && !_firstRendered)
		{
			try
			{
				_module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Features/ScrollSpy/Index.razor.js");
				if (_module != null)
				{
					await _module.InvokeVoidAsync("setFocusToElement", $"verse-{CurrentScrollToScriptureId}");
				}
			}
			catch (Exception ex)
			{
				Logger!.LogError(ex, "{Method} failed to load JS module or set focus", nameof(OnAfterRenderAsync));
			}
			_firstRendered = true;
		}

		if (_module is not null)
		{
			await _module.InvokeVoidAsync("setFocusToElement", $"verse-{CurrentScrollToScriptureId}");
		}

	}

	private async Task ReturnedSetFocus(int scriptureId)
	{
		if (_module is not null)
		{
			//Toast!.ShowWarning($"{nameof(ReturnedSetFocus)} Id: {scriptureId}");
			CurrentScrollToScriptureId = scriptureId;
			await _module.InvokeVoidAsync("setFocusToElement", $"verse-{scriptureId}");
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (_module is not null)
		{
			await _module.DisposeAsync();
		}
	}
}

