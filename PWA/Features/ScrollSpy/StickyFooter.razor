<div class="bg-info-subtle p-1">
	
	<div class="d-flex justify-content-center align-items-center m-0 pb-1">
		<span class="fs-6 fw-bold text-danger">@((MarkupString)Title)</span>
		@if (TextFilter is not null)
		{
			@* 
				ToDo: This button is buried in this component and I'm thinking it needs to be pulled out
				I say this because the logic for clearing the filter needs to be done in other places
			*@
			<div class="border border-secondary rounded ms-2 px-1 py-1 d-inline-flex align-items-center">
				<span class="fs-6 fst-italic fw-light px-2 ms-2">
					<i class='fa-solid fa-filter'></i> @TextFilter
				</span>
				<button type="button"
						class="btn p-0 text-danger"
						title="Clear filter"
						@onclick="ClearButtonClicked">
					<i class="fa-solid fa-xmark"></i>
				</button>
			</div>

		}
	</div>

	<div class="d-flex justify-content-between">
		
		<div class="d-flex justify-content-start">
			<ActionButtons ActionGroup="Enums.ActionGroupEnum.Left" OnActionSelected="ReturnedAction" />
		</div>
		<div class="d-flex justify-content-center">
			<ActionButtons ActionGroup="Enums.ActionGroupEnum.Center" OnActionSelected="ReturnedAction" />
		</div>
		<div class="d-flex justify-content-end">
			<ActionButtons ActionGroup="Enums.ActionGroupEnum.Right" OnActionSelected="ReturnedAction" />
		</div>

	</div>
</div>

@code {
	[Parameter, EditorRequired] public string Title { get; set; }
	[Parameter] public string? TextFilter { get; set; }
	[Parameter, EditorRequired] public EventCallback<Enums.Action> OnActionSelected { get; set; }
	[Parameter, EditorRequired] public EventCallback OnClearClicked { get; set; }

	private void ReturnedAction(Enums.Action action)
	{
		OnActionSelected.InvokeAsync(action);
	}

	private void ClearButtonClicked()
	{
		//TitleSuffix = null;
		OnClearClicked.InvokeAsync();
	}
}
