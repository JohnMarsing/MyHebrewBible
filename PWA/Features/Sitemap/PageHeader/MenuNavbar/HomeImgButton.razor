@inject NavigationManager NavigationManager

<div>
	<border @onclick="NavigateToHome" class="" aria-label="Home" style="cursor: pointer;">
		<img src="/favicon.ico" class="rounded" alt="logo" /> 
	</border>
</div>


@code {
	
	private void NavigateToHome()
	{
		NavigationManager.NavigateTo("/");
	}
}
