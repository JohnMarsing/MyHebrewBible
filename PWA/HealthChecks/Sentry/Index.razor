@page "/HealthChecks/sentry"
@using PWA.HealthChecks.Enums

<PageTitle>@Nav.HealthCheckSentry.Title</PageTitle>
<Buttons Title="@Nav.HealthCheckSentry.Title" />

<ButtonCardTemplate Buttons="@(Button.List.Where(b => b.GroupTypeEnum == GroupType.Sentry).OrderBy(b => b.Value).ToList())"
										OnButtonSelected="@ReturnedButton" />

@if (currentButton != null)
{
	<section class="px-2">
		@* <h1 class="text-center">@currentButton.GroupTypeEnum</h1> *@
		<h3 class="text-center">@currentButton.Title</h3>
		@if (currentButton == Button.Throw)
		{
			<Thrower />
		}
		else
		{
			if (currentButton == Button.ThrowAndCatch)
			{
				<Catcher />
			}
		}
	</section>
}

@code {
	Button? currentButton = null;

	private void ReturnedButton(Button button)
	{
		currentButton = button;
	}
}
