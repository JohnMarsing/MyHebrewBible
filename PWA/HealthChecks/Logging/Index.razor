@code {
	[CascadingParameter] private ProcessError? ProcessError { get; set; }

	private int currentCount = 0;

	private void IncrementCount()
	{
		try
		{
			currentCount++;

			if (currentCount > 5)
			{
				throw new InvalidOperationException("Current count is over five!");
			}
		}
		catch (Exception ex)
		{
			ProcessError!.LogErrorWithMessage(ex, $"Error in {nameof(IncrementCount)}");
		}
	}

