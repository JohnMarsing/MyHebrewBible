@page "/HealthChecks/Database"
@using PWA.HealthChecks.Enums

<PageTitle>@Nav.HealthCheckDatabase.Title</PageTitle>
<Buttons Title="@Nav.HealthCheckDatabase.Title" />

<ButtonCardTemplate Buttons="@(Button.List.Where(b => b.GroupTypeEnum == GroupType.Database).OrderBy(b => b.Value).ToList())"
										OnButtonSelected="@ReturnedButton" />

@if (currentButton != null)
{
	<section class="px-2">
		<h3 class="text-center">@currentButton.Title</h3>

		@if (currentButton == Button.TableRowCntTable)
		{
			<TableRowCntTable />
		}
		else if (currentButton == Button.Gen01)
		{
			<Gen01 />
		}
		else if (currentButton == Button.TestSqlite)
		{
			<TestSqlite />
		}
	</section>
}

@code {
	Button? currentButton = null;

	private void ReturnedButton(Button button)
	{
		currentButton = button;
	}
}
