@using Microsoft.AspNetCore.Components.WebAssembly.Hosting

@inject IWebAssemblyHostEnvironment HostEnvironment
@inject ILogger<ProcessError> Logger
@inject Sentry.ISentryClient SentryClient   // Optional: for direct access
@inject IToastService? Toast

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
  [Parameter]  public RenderFragment? ChildContent { get; set; }

  public void LogError(Exception ex)
  {
    // 1. Always log locally with ILogger (goes to browser console + Sentry via integration)
    if (HostEnvironment.IsDevelopment())
    {
      // Full rich logging in development
      Logger.LogError(ex, "ProcessError.LogError: {Type} - {Message}", ex.GetType().Name, ex.Message);
    }
    else
    {
      // Lighter logging in production (still sent to Sentry)
      Logger.LogError("ProcessError.LogError: {Type} - {Message}", ex.GetType().Name, ex.Message);
    }

    // 2. Send directly to Sentry (rich context, stack trace, etc.)
    SentrySdk.CaptureException(ex, scope =>
    {
      scope.SetTag("component", "ProcessError");
      scope.SetExtra("logged_via", "ProcessError.LogError");
      // You can add more context here (user id, current route, etc.)
    });
  }

  public void LogErrorWithMessage(Exception ex, string userMessage)
  {
    LogError(ex);
    Toast!.ShowError($"{Global.ToastShowError} | {userMessage}");
  }
}
