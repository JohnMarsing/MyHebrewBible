@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting

@inject IWebAssemblyHostEnvironment HostEnvironment
@inject ILogger<ProcessError> Logger
@inject Sentry.ISentryClient SentryClient
@inject IToastService? Toast
@inject NavigationManager Navigation

<CascadingValue Value="this" IsFixed="true">
  @ChildContent
</CascadingValue>

@code {
  [Parameter] public RenderFragment? ChildContent { get; set; }

  public void LogError(Exception ex, string? classname, string? methodname, Enums.Nav? nav, string? userMessage)
  {
    Logger.LogError(ex,
      "{Class} {Method} {Nav} {Message} {Type}",
      classname, methodname, nav, userMessage, ex.GetType().Name);

    SentrySdk.CaptureException(ex, scope =>
    {
      var currentUrl = Navigation.Uri;
      var currentRoute = Navigation.ToBaseRelativePath(currentUrl);

      if (string.IsNullOrWhiteSpace(currentRoute))
      {
        currentRoute = "/";
      }
      else
      {
        currentRoute = "/" + currentRoute;
      }

      scope.SetTag("component", "ProcessError");
      scope.SetTag("route", currentRoute);
      scope.SetExtra("current_url", currentUrl);
      scope.SetExtra("logged_via", "ProcessError.LogError");
    });
  }

  public void LogErrorWithMessage(Exception ex, string? classname, string? methodname, Enums.Nav nav, string userMessage)
  {
    LogError(ex, classname, methodname, nav, userMessage);
		ShowToast(userMessage, ToastLevel.Error); 
  }

  public void ShowToast(string userMessage, ToastLevel toastLevel)
	{
    switch (toastLevel)
    {
      case ToastLevel.Error:
        Toast!.ShowError($"An invalid operation occurred, contact your administrator | {userMessage}");
        break;
      case ToastLevel.Warning:
        Toast!.ShowWarning(userMessage);
        break;
      case ToastLevel.Info:
        Toast!.ShowInfo(userMessage);
        break;
      case ToastLevel.Success:
        Toast!.ShowSuccess(userMessage);
        break;
    }

	} 
}
