@if (IsLoading)
{
	if (TurnSpinnerOff == false)
	{
		<div class="text-center fs-5 mb-1">Loading @BookChapter</div>
		@* <div class="spinner-border" role="status"></div> *@

		<div class="d-flex justify-content-center align-items-center my-3">
			<div class="torah-spinner" role="status" aria-label="Loading">
				<div class="roller left"></div>
				<div class="parchment"></div>
				<div class="roller right"></div>
			</div>
		</div>
	}
}
else
{
	@ChildContent
}

@code {
	[Parameter, EditorRequired] public bool IsLoading { get; set; }
	[Parameter, EditorRequired] public string BookChapter { get; set; } = "";
	[Parameter, EditorRequired] public bool TurnSpinnerOff { get; set; } = false;
	[Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
